{% doc %}
  Renders a side panel: a modal dialog that comes in from the right, used for enquiry and contact forms.
  Any element with data-side-panel-open="<id>" opens it. Escape, the close link and a click outside close it.
  Without JavaScript, a link to #<id> still shows the panel (CSS :target).
  The panel opens itself on load when open is true, e.g. after its form was posted.

  @param {string} id - Element id of the panel, also the #anchor its triggers link to
  @param {string} title - Heading shown at the top of the panel
  @param {string} content - The panel body (HTML, usually captured)
  @param {string} [form_id] - Id of the form inside, so the right panel reopens after posting
  @param {boolean} [open] - Open on page load
  @param {string} [contact_path] - Makes this the contact panel: links to this path open it instead of the page

  @example
  {%- capture body -%}...{%- endcapture -%}
  {% render 'side-panel', id: 'enquire', title: heading, content: body, form_id: 'ProductEnquiry' %}
{% enddoc %}

<dialog
  id="{{ id }}"
  class="side-panel"
  aria-labelledby="{{ id }}-title"
  data-side-panel
  {% if form_id %}
    data-form-id="{{ form_id }}"
  {% endif %}
  {% if open %}
    data-open-on-load
  {% endif %}
  {% if contact_path %}
    data-contact-panel
    data-contact-path="{{ contact_path | escape }}"
  {% endif %}
>
  <div class="side-panel__inner">
    <div class="side-panel__header">
      <h2 id="{{ id }}-title" class="side-panel__title">{{ title | escape }}</h2>
      <a class="side-panel__close" href="#" data-side-panel-close>
        {%- render 'icon', name: 'close' -%}
        <span>{{ 'header.close' | t }}</span>
      </a>
    </div>
    <div class="side-panel__body">
      {{ content }}
    </div>
  </div>
</dialog>

{% javascript %}
  (function () {
    var root = document.documentElement;
    root.classList.add('js-panels');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    var opener = null;

    /* After a send, show the form again (name, email and phone kept, message cleared) */
    function showFields(scope) {
      var sent = scope.querySelector('[data-form-sent]');
      var fields = scope.querySelector('[data-form-fields]');
      if (!sent || !fields || !fields.hidden) return;
      sent.hidden = true;
      fields.hidden = false;
      var message = fields.querySelector('textarea');
      if (message) message.value = '';
    }

    function openPanel(panel, trigger) {
      if (!panel || typeof panel.showModal !== 'function') return false;
      if (panel.open) return true;
      /* Opened by the visitor (not the reopen after a send): start with a fresh form */
      if (trigger) showFields(panel);
      opener = trigger || document.activeElement;
      var drawer = document.querySelector('.site-header__drawer[open]');
      if (drawer) drawer.removeAttribute('open');
      panel.classList.remove('is-closing');
      panel.showModal();
      var field = panel.querySelector('input:not([type="hidden"]):not([readonly]), textarea, select');
      if (field) field.focus({ preventScroll: true });
      return true;
    }

    function closePanel(panel) {
      if (!panel || !panel.open || panel.classList.contains('is-closing')) return;
      var finish = function () {
        panel.classList.remove('is-closing');
        panel.close();
        if (opener && document.contains(opener)) opener.focus({ preventScroll: true });
      };
      if (reduceMotion.matches) {
        finish();
        return;
      }
      panel.classList.add('is-closing');
      window.setTimeout(finish, 300);
    }

    /* Links to the contact page open the contact panel instead, except on the contact page itself */
    function contactPanelFor(link) {
      var panel = document.querySelector('[data-contact-panel]');
      if (!panel || link.hash || link.target === '_blank') return null;
      var path = panel.getAttribute('data-contact-path');
      if (!path || link.origin !== window.location.origin) return null;
      if (link.pathname !== path || window.location.pathname === path) return null;
      return panel;
    }

    document.addEventListener('click', function (event) {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return;

      var trigger = event.target.closest('[data-side-panel-open]');
      if (trigger) {
        if (openPanel(document.getElementById(trigger.getAttribute('data-side-panel-open')), trigger)) event.preventDefault();
        return;
      }

      var again = event.target.closest('[data-form-again]');
      if (again) {
        var scope = again.closest('form') || document;
        showFields(scope);
        var first = scope.querySelector('[data-form-fields] input:not([type="hidden"]), [data-form-fields] textarea');
        if (first) first.focus();
        return;
      }

      var closer = event.target.closest('[data-side-panel-close]');
      if (closer) {
        event.preventDefault();
        closePanel(closer.closest('[data-side-panel]'));
        return;
      }

      /* A click on the backdrop lands on the dialog itself, outside its inner content */
      if (event.target.matches('[data-side-panel]')) {
        closePanel(event.target);
        return;
      }

      var link = event.target.closest('a[href]');
      if (!link) return;

      /* A link to #<panel id> on this page opens that panel */
      if (link.hash && link.pathname === window.location.pathname) {
        var target = document.getElementById(link.hash.slice(1));
        if (target && target.matches('[data-side-panel]')) {
          if (openPanel(target, link)) event.preventDefault();
          return;
        }
      }

      var contact = contactPanelFor(link);
      if (contact && openPanel(contact, link)) event.preventDefault();
    });

    document.querySelectorAll('[data-side-panel]').forEach(function (panel) {
      panel.addEventListener('cancel', function (event) {
        event.preventDefault();
        closePanel(panel);
      });
    });

    /* Reopen the panel whose form was just posted, so the thank-you or the errors show where the form was */
    function openOnLoad() {
      var waiting = Array.prototype.slice.call(document.querySelectorAll('[data-side-panel][data-open-on-load]'));
      var hash = window.location.hash.slice(1);
      var panel =
        waiting.filter(function (item) { return hash && (item.id === hash || item.getAttribute('data-form-id') === hash); })[0] ||
        waiting[0] ||
        (hash && document.querySelector('[data-side-panel]#' + CSS.escape(hash)));
      if (panel) openPanel(panel);

      /* Tidy the address bar, so a refresh does not reopen the thank-you */
      if (window.location.search.indexOf('contact_posted') !== -1) {
        var url = new URL(window.location.href);
        url.searchParams.delete('contact_posted');
        url.hash = '';
        window.history.replaceState(window.history.state, '', url);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', openOnLoad);
    } else {
      openOnLoad();
    }
  })();
{% endjavascript %}

{% stylesheet %}
  .side-panel {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(480px, 100%);
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--color-hairline);
    background-color: var(--color-ivory);
    color: var(--color-ink);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .side-panel::backdrop {
    background-color: rgb(from var(--color-ink) r g b / 0.28);
  }

  @supports not (background-color: rgb(from red r g b / 0.5)) {
    .side-panel::backdrop {
      background-color: rgba(34, 32, 30, 0.28);
    }
  }

  /* Without JavaScript, a link to the panel's #id shows it in place */
  html:not(.js-panels) .side-panel:target {
    display: block;
    z-index: 50;
  }

  html:has(.side-panel[open]) {
    overflow: hidden;
  }

  .side-panel[open] {
    animation:
      motion-fade var(--dur-swap) var(--ease-fade) both,
      side-panel-in var(--dur-swap) var(--ease-out) both;
  }

  .side-panel[open]::backdrop {
    animation: motion-fade var(--dur-swap) var(--ease-fade) both;
  }

  .side-panel.is-closing {
    animation: motion-fade-out 300ms var(--ease-fade) both;
  }

  .side-panel.is-closing::backdrop {
    animation: motion-fade-out 300ms var(--ease-fade) both;
  }

  @keyframes side-panel-in {
    from {
      transform: translateX(16px);
    }
    to {
      transform: none;
    }
  }

  .side-panel__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 32px 40px 48px;
  }

  .side-panel__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .side-panel__title {
    font-size: 26px;
    line-height: 1.3;
  }

  .side-panel__close {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    font-size: var(--text-size-caption);
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .side-panel__body {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* The painting or candle an enquiry is about, at the top of the panel */
  .enquiry-summary {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .enquiry-summary[hidden] {
    display: none;
  }

  .enquiry-summary__image {
    flex: 0 0 72px;
    width: 72px;
  }

  .enquiry-summary__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .enquiry-summary__title {
    font-weight: var(--font-weight-regular);
  }

  .enquiry-summary__meta {
    font-size: var(--text-size-small);
    color: var(--color-muted);
  }

  /* Forms inside a panel: one column, slightly tighter than on a page */
  .side-panel form {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .side-panel .button[type='submit'] {
    align-self: stretch;
  }

  @media (max-width: 749px) {
    .side-panel {
      border-left: 0;
    }

    .side-panel__inner {
      padding: 20px var(--page-gutter) 40px;
    }
  }
{% endstylesheet %}
