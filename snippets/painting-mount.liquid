{% doc %}
  Renders a painting inside the square mount. Every painting on the site uses this so grids stay balanced:
  a 1:1 mount in the mount colour, with the painting centred and its longest side at 76% of the mount.
  Not for lifestyle or installation photos, which fill their frame instead.

  @param {image} [image] - The painting image. An empty mount is shown when missing.
  @param {string} alt - Fallback alt text, usually the painting title, used when the image has none
  @param {string} [sizes] - The sizes attribute for the responsive image
  @param {boolean} [eager] - Load immediately with high priority (above the fold). Defaults to lazy.
  @param {string} [class] - Extra class for the mount

  @example
  {% render 'painting-mount', image: product.featured_media.preview_image, alt: product.title, sizes: '(min-width: 990px) 400px, 100vw' %}
{% enddoc %}

{%- liquid
  assign image_alt = image.alt | default: alt | escape
  assign image_sizes = sizes | default: '(min-width: 1320px) 400px, (min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw'
  if eager
    assign image_loading = 'eager'
    assign image_priority = 'high'
  else
    assign image_loading = 'lazy'
    assign image_priority = 'auto'
  endif
-%}

<div class="mount {{ class }}">
  {%- if image -%}
    {{
      image
      | image_url: width: 2000
      | image_tag:
        class: 'mount__image',
        widths: '300, 400, 500, 600, 800, 1000, 1200, 1500, 2000',
        sizes: image_sizes,
        loading: image_loading,
        fetchpriority: image_priority,
        alt: image_alt
    }}
  {%- else -%}
    <span class="visually-hidden">{{ alt | escape }}</span>
  {%- endif -%}
</div>

{% stylesheet %}
  .mount {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-mount);
  }

  .mount__image {
    position: absolute;
    top: 12%;
    left: 12%;
    width: 76%;
    height: 76%;
    max-width: none;
    object-fit: contain;
  }
{% endstylesheet %}
