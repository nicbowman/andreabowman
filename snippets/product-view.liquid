{% doc %}
  Renders one view in the product gallery stage: the image, linked to a larger version for the lightbox.
  The first view sits in the painting mount; other views (details, rooms) fill a square frame.

  @param {image} [image] - The image. An empty mount is shown when missing and mounted is true.
  @param {string} id - Element id, referenced by the matching thumbnail's aria-controls
  @param {string} alt - Alt text, also used for the lightbox and zoom label
  @param {boolean} [mounted] - Show in the painting mount instead of a cover frame
  @param {boolean} [active] - The view shown first. Other views are hidden until chosen.
  @param {string} sizes - Sizes attribute for the responsive image

  @example
  {% render 'product-view', image: product.images[0], id: 'ProductView-1', alt: product.title, mounted: true, active: true, sizes: main_sizes %}
{% enddoc %}

{%- liquid
  assign view_loading = 'lazy'
  assign view_priority = 'auto'
  if active
    assign view_loading = 'eager'
    assign view_priority = 'high'
  endif
-%}

<div id="{{ id }}" class="product__view{% if active %} is-active{% endif %}" {% unless active %}hidden{% endunless %}>
  {%- if image -%}
    <a
      class="product__zoom{% unless mounted %} product__frame{% endunless %}"
      href="{{ image | image_url: width: 2400 }}"
      data-zoom
      data-zoom-alt="{{ alt | escape }}"
      aria-label="{{ 'products.zoom' | t: view: alt | escape }}"
    >
      {%- if mounted -%}
        {% render 'painting-mount', image: image, alt: alt, eager: active, sizes: sizes %}
      {%- else -%}
        {{
          image
          | image_url: width: 2000
          | image_tag:
            widths: '400, 600, 800, 1000, 1200, 1500, 2000',
            sizes: sizes,
            loading: view_loading,
            fetchpriority: view_priority,
            alt: alt
        }}
      {%- endif -%}
      <span class="product__zoom-hint">{%- render 'icon', name: 'zoom' -%}</span>
    </a>
  {%- else -%}
    {% render 'painting-mount', image: image, alt: alt, eager: active, sizes: sizes %}
  {%- endif -%}
</div>
