{% comment %}
  Holding version of the works page: title and the painting grid. Tabs and styled pagination arrive in feature/collection-page.
{% endcomment %}

<div class="page-width section">
  <div class="section-heading">
    <h1 class="h2">{{ collection.title | escape }}</h1>
  </div>

  {%- paginate collection.products by 24 -%}
    <ul class="product-grid" role="list">
      {%- for product in collection.products -%}
        <li>
          {%- liquid
            assign eager = false
            if forloop.index <= 3
              assign eager = true
            endif
          -%}
          {% render 'product-card', product: product, eager: eager, heading_tag: 'h2' %}
        </li>
      {%- endfor -%}
    </ul>

    {{ paginate | default_pagination }}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
