{%- liquid
  assign per_page = section.settings.products_per_page
-%}

<div class="page-width works">
  {%- liquid
    assign intro = collection.description
    if intro == blank
      assign intro = section.settings.intro
    endif
    if section.settings.kind == 'piece'
      assign count_text = 'collections.count_pieces' | t: count: collection.products_count
    elsif collection.handle == section.settings.sold_collection.handle
      assign count_text = 'collections.count_sold' | t: count: collection.products_count
    else
      assign count_text = 'collections.count_available' | t: count: collection.products_count
    endif
  -%}
  {%- comment -%} The menu and tabs already say what is shown, so the collection title is for search engines and screen readers only {%- endcomment -%}
  <h1 class="visually-hidden">{{ collection.title | escape }}</h1>

  {%- if intro != blank -%}
    <div class="rte works__intro">{{ intro }}</div>
  {%- endif -%}

  <div class="section-heading works__bar">
    {%- comment -%} Interiors and Garden have no Available / Sold split: sold out pieces stay in the grid with a label {%- endcomment -%}
    {%- unless section.settings.kind == 'piece' -%}
      {% render 'works-tabs',
        available: section.settings.available_collection,
        sold: section.settings.sold_collection,
        current_handle: collection.handle
      %}
    {%- endunless -%}
    {%- if collection.products_count > 0 -%}
      <p class="text-caption works__count">{{ count_text }}</p>
    {%- endif -%}
  </div>

  {%- paginate collection.products by per_page -%}
    {%- if collection.products.size > 0 -%}
      <ul class="product-grid" role="list">
        {%- for product in collection.products -%}
          <li>
            {%- liquid
              assign eager = false
              if forloop.index <= 3 and paginate.current_page == 1
                assign eager = true
              endif
            -%}
            {% render 'product-card', product: product, eager: eager, heading_tag: 'h2' %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="text-soft works__empty">{{ 'collections.empty' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="{{ 'collections.pagination_label' | t }}">
        {%- if paginate.previous -%}
          <a class="pagination__step" href="{{ paginate.previous.url }}">
            {%- render 'icon', name: 'arrow-left', class: 'icon--small' -%}
            {{- 'collections.previous' | t -}}
          </a>
        {%- else -%}
          <span class="pagination__step" aria-hidden="true"></span>
        {%- endif -%}

        <ul class="pagination__pages" role="list">
          {%- for part in paginate.parts -%}
            <li>
              {%- if part.is_link -%}
                <a class="pagination__page" href="{{ part.url }}">
                  <span class="visually-hidden">{{ 'collections.page' | t }}</span>
                  {{- part.title -}}
                </a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="pagination__page" aria-current="page">
                  <span class="visually-hidden">{{ 'collections.page' | t }}</span>
                  {{- part.title -}}
                </span>
              {%- else -%}
                <span class="pagination__page pagination__gap">{{ part.title }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.next -%}
          <a class="pagination__step pagination__step--next" href="{{ paginate.next.url }}">
            {{- 'collections.next' | t -}}
            {%- render 'icon', name: 'arrow-right', class: 'icon--small' -%}
          </a>
        {%- else -%}
          <span class="pagination__step" aria-hidden="true"></span>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .works {
    padding-top: var(--page-top);
    padding-bottom: var(--section-space-large);
  }

  .works__intro {
    max-width: 760px;
    margin-bottom: var(--page-top);
    font-size: 21px;
    line-height: 1.6;
  }

  .works__intro p {
    color: var(--color-ink-soft);
  }

  .works__bar {
    align-items: center;
  }

  .works__bar .works-tabs {
    gap: 40px;
    font-size: var(--text-size-body);
    letter-spacing: 0.02em;
  }

  .works__count {
    font-variant-numeric: tabular-nums;
  }

  .works__empty {
    padding-block: 40px;
  }

  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    margin-top: 96px;
    padding-top: 28px;
    border-top: 1px solid var(--color-hairline);
    font-size: var(--text-size-caption);
    letter-spacing: 0.06em;
  }

  .pagination__step,
  .pagination__page {
    display: inline-block;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
  }

  .pagination__step--next {
    justify-self: end;
  }

  a.pagination__step {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .pagination__pages {
    display: flex;
    gap: 24px;
    padding: 0;
    list-style: none;
  }

  .pagination__page[aria-current] {
    border-bottom-color: var(--color-ink);
  }

  .pagination__gap {
    color: var(--color-muted);
  }

  .pagination a {
    text-decoration: none;
  }

  @media (max-width: 749px) {
    .works {
      padding-top: var(--page-top);
    }

    .works__intro {
      font-size: 19px;
    }

    .pagination {
      margin-top: 64px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "select",
      "id": "kind",
      "label": "t:labels.kind",
      "info": "t:info.collection_kind",
      "options": [
        { "value": "painting", "label": "t:options.kind.painting" },
        { "value": "piece", "label": "t:options.kind.piece" }
      ],
      "default": "painting"
    },
    {
      "type": "collection",
      "id": "available_collection",
      "label": "t:labels.available_collection"
    },
    {
      "type": "collection",
      "id": "sold_collection",
      "label": "t:labels.sold_collection"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:labels.intro",
      "info": "t:info.works_intro",
      "default": "<p>Original paintings, each one of a kind. Every painting can be viewed in person by appointment.</p>"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:labels.products_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
