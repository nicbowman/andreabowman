<section class="page-width columns" aria-labelledby="Heading-{{ section.id }}">
  <div class="section-heading">
    <h2 id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  </div>

  {%- if section.blocks.size > 0 -%}
    <ul class="columns__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="columns__item" {{ block.shopify_attributes }}>
          <h3 class="columns__title">{{ block.settings.title | escape }}</h3>
          <div class="rte">{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% stylesheet %}
  .columns {
    padding-bottom: var(--section-space);
  }

  .columns__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 40px;
    padding: 0;
    list-style: none;
  }

  .columns__item {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .columns__title {
    font-size: 19px;
    font-weight: var(--font-weight-regular);
    line-height: 1.4;
  }

  @media (max-width: 989px) {
    .columns__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .columns__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.columns",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:general.column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.heading",
          "default": "[Title]"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>[Text]</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:general.columns",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
