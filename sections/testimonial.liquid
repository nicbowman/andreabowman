{%- liquid
  assign chosen = section.settings.testimonial
  assign count = section.settings.rotate_count
  assign entries = metaobjects.testimonial.values
-%}

{%- if chosen or entries.size > 0 -%}
  <section class="section section--oatmeal testimonial" data-testimonials>
    {%- if chosen -%}
      {% render 'testimonial-quote', entry: chosen %}
    {%- else -%}
      {%- for entry in entries limit: count -%}
        {%- liquid
          assign hidden = true
          if forloop.first
            assign hidden = false
          endif
        -%}
        {% render 'testimonial-quote', entry: entry, hidden: hidden %}
      {%- endfor -%}
    {%- endif -%}
  </section>

  {%- unless chosen -%}
    <script>
      (function () {
        var section = document.currentScript.previousElementSibling;
        var quotes = section.querySelectorAll('.testimonial__inner');
        if (quotes.length < 2) return;
        var pick = Math.floor(Math.random() * quotes.length);
        quotes.forEach(function (quote, index) {
          quote.hidden = index !== pick;
        });
      })();
    </script>
  {%- endunless -%}
{%- elsif request.design_mode -%}
  <section class="section section--oatmeal testimonial">
    <p class="page-width text-muted">{{ 'features.empty_testimonial' | t }}</p>
  </section>
{%- endif -%}

{% stylesheet %}
  .testimonial {
    padding-block: var(--section-space-small);
  }

  .testimonial__inner {
    max-width: 900px;
    margin-block: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
    text-align: center;
  }

  .testimonial__quote {
    font-size: 30px;
    line-height: 1.45;
  }

  .testimonial__cite {
    font-size: var(--text-size-caption);
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  @media (max-width: 749px) {
    .testimonial__quote {
      font-size: 23px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.testimonial",
  "settings": [
    {
      "type": "metaobject",
      "id": "testimonial",
      "metaobject_type": "testimonial",
      "label": "t:labels.testimonial",
      "info": "t:info.testimonial"
    },
    {
      "type": "range",
      "id": "rotate_count",
      "label": "t:labels.rotate_count",
      "info": "t:info.rotate_count",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "t:general.testimonial"
    }
  ]
}
{% endschema %}
