{%- comment -%}
  Draws paintings from a collection to scale, side by side with a 1.7 m figure, hung with their centres at 150 cm.
  Sizes come from each painting's Dimensions field (width x height), so the drawing updates as works sell or arrive.
  Paintings without readable dimensions are skipped.
{%- endcomment -%}

{%- liquid
  assign source = section.settings.collection
  assign limit = section.settings.items_to_show
  assign gap_cm = 30
  assign person_gap_cm = 60
  assign person_width_cm = 46
  assign total_cm = 0
  assign total_small_cm = 0
  assign shown = 0
  assign tallest = 170
-%}

{%- capture items -%}
  {%- if source != blank -%}
    {%- for product in source.products -%}
      {%- liquid
        if shown >= limit
          break
        endif
        assign dims = product.metafields.custom.dimensions.value | downcase | remove: 'cm' | split: 'x'
        assign w = dims[0] | strip | plus: 0
        assign h = dims[1] | strip | plus: 0
        if w <= 0 or h <= 0
          continue
        endif
        assign shown = shown | plus: 1
        assign total_cm = total_cm | plus: w
        if shown > 1
          assign total_cm = total_cm | plus: gap_cm
        endif
        if shown <= 2
          assign total_small_cm = total_small_cm | plus: w
          if shown > 1
            assign total_small_cm = total_small_cm | plus: gap_cm
          endif
        endif
        assign half = h | divided_by: 2.0
        assign top_cm = 150 | plus: half
        if top_cm > tallest
          assign tallest = top_cm
        endif
        assign lift = 150 | minus: half
        assign image_alt = product.title | escape
      -%}
      <li class="size-guide__item" style="--w: {{ w }}; --h: {{ h }}; --lift: {{ lift }};">
        <a class="size-guide__canvas" href="{{ product.url }}">
          {%- if product.featured_image -%}
            {{
              product.featured_image
              | image_url: width: 600
              | image_tag:
                widths: '200, 300, 400, 600',
                sizes: '(min-width: 990px) 220px, 30vw',
                loading: 'lazy',
                alt: image_alt
            }}
          {%- else -%}
            <span class="visually-hidden">{{ product.title | escape }}</span>
          {%- endif -%}
        </a>
        <span class="size-guide__label">
          <span class="size-guide__name">{{ product.title | escape }}</span>
          <span class="size-guide__dims">{{ w }} x {{ h }} cm</span>
        </span>
      </li>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  assign total_cm = total_cm | plus: person_gap_cm | plus: person_width_cm | plus: 60
  assign total_small_cm = total_small_cm | plus: person_gap_cm | plus: person_width_cm | plus: 60
  assign tallest = tallest | plus: 24
-%}

{%- if shown > 0 or request.design_mode -%}
  <section class="size-guide size-guide--{{ section.settings.background }}" aria-labelledby="Heading-{{ section.id }}">
    <div class="page-width size-guide__inner">
      <div class="section-heading">
        <h2 id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.link_label != blank and source != blank -%}
          <a class="link link--icon" href="{{ source.url }}">
            {{- section.settings.link_label | escape -}}
            {% render 'icon', name: 'arrow-right', class: 'icon--small' %}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.text != blank -%}
        <div class="rte size-guide__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if shown > 0 -%}
        <div class="size-guide__scene" style="--total: {{ total_cm }}; --total-small: {{ total_small_cm }}; --tallest: {{ tallest | ceil }};">
          <ul class="size-guide__row" role="list">
            {{- items -}}
            <li class="size-guide__item size-guide__person" aria-hidden="true">
              <svg class="size-guide__figure" viewBox="0 0 46 170" preserveAspectRatio="none">
                <circle cx="23" cy="11" r="11"></circle>
                <rect x="5" y="20" width="36" height="74" rx="16"></rect>
                <rect x="9" y="88" width="12" height="82" rx="5"></rect>
                <rect x="25" y="88" width="12" height="82" rx="5"></rect>
              </svg>
              <span class="size-guide__label">
                <span class="size-guide__dims">{{ 'general.figure_height' | t }}</span>
              </span>
            </li>
          </ul>
        </div>
      {%- else -%}
        <p class="text-soft">{{ 'general.size_guide_empty' | t }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .size-guide--oatmeal {
    background-color: var(--color-oatmeal);
  }

  .size-guide__inner {
    padding-block: var(--section-space);
  }

  .size-guide--ivory .size-guide__inner {
    padding-top: 0;
  }

  .size-guide__text {
    max-width: 640px;
    margin-bottom: 48px;
  }

  /* One centimetre is a share of the scene width, so every painting and the figure keep true proportions */
  .size-guide__scene {
    --cm: calc(100cqw / var(--total));
    container-type: inline-size;
    padding-bottom: 64px;
  }

  .size-guide__row {
    --cm: calc(100cqw / var(--total));
    display: flex;
    align-items: flex-end;
    gap: calc(var(--cm) * 30);
    height: calc(var(--cm) * var(--tallest));
    padding: 0 calc(var(--cm) * 30);
    list-style: none;
    background-color: var(--color-mount);
    border-bottom: 1px solid var(--color-field-line);
  }

  .size-guide__item {
    position: relative;
    flex: none;
    width: calc(var(--cm) * var(--w));
    padding-bottom: calc(var(--cm) * var(--lift));
  }

  .size-guide__canvas {
    position: relative;
    display: block;
    height: calc(var(--cm) * var(--h));
    overflow: hidden;
    background-color: var(--color-hairline);
    outline-offset: 4px;
  }

  .size-guide__canvas img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .size-guide__canvas:hover img {
    transform: scale(1.02);
  }

  .size-guide__person {
    --w: 46;
    margin-left: calc(var(--cm) * 30);
    padding-bottom: 0;
  }

  .size-guide__figure {
    width: 100%;
    height: calc(var(--cm) * 170);
    fill: var(--color-field-line);
  }

  .size-guide__label {
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    display: flex;
    flex-direction: column;
    width: max-content;
    max-width: 200px;
    font-size: var(--text-size-label);
    line-height: 1.5;
  }

  .size-guide__person .size-guide__label {
    left: auto;
    right: 0;
    text-align: right;
  }

  .size-guide__name {
    color: var(--color-ink);
  }

  .size-guide__dims {
    color: var(--color-muted);
  }

  @media (max-width: 749px) {
    .size-guide__row {
      --cm: calc(100cqw / var(--total-small));
    }

    .size-guide__row > .size-guide__item:nth-child(n + 3):not(.size-guide__person) {
      display: none;
    }

    .size-guide__text {
      margin-bottom: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .size-guide__canvas:hover img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.size_guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "To scale"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection",
      "info": "t:info.size_guide_collection"
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "t:labels.items_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "View all works"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "ivory", "label": "t:options.background.ivory" },
        { "value": "oatmeal", "label": "t:options.background.oatmeal" }
      ],
      "default": "ivory"
    }
  ],
  "presets": [
    {
      "name": "t:general.size_guide"
    }
  ]
}
{% endschema %}
