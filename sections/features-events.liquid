{%- liquid
  assign limit = section.settings.items_to_show
  capture handle_list
    render 'handles-by-date', entries: metaobjects.event.values
  endcapture
  assign handles = handle_list | strip | split: ','
-%}

{%- if handles.size > 0 or request.design_mode -%}
<section
  id="{{ section.settings.anchor | handleize | default: section.id }}"
  class="page-width feature-list feature-events"
  aria-labelledby="Heading-{{ section.id }}"
>
  <div class="section-heading">
    <h2 id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  </div>

  {%- if handles.size > 0 -%}
    <ul class="feature-events__grid" role="list">
      {%- for handle in handles limit: limit -%}
        {%- liquid
          assign handle = handle | strip
          assign entry = metaobjects.event[handle]
          assign venue = entry.venue.value
          assign date = entry.date.value
        -%}
        <li>
          <figure class="feature-events__item">
            {% render 'cover-image',
              image: entry.image.value,
              ratio: '3-2',
              alt: entry.name.value,
              captioned: true,
              sizes: '(min-width: 1320px) 600px, (min-width: 750px) 50vw, 100vw'
            %}
            <figcaption class="feature-caption">
              <span class="feature-caption__title">{{ entry.name.value | escape }}</span>
              {%- if venue != blank or date != blank -%}
                <span class="feature-caption__meta">
                  {{- venue | escape -}}
                  {%- if venue != blank and date != blank %}, {% endif -%}
                  {%- if date != blank %}{{ date | date: '%B %Y' }}{% endif -%}
                </span>
              {%- endif -%}
            </figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  {%- elsif request.design_mode -%}
    <p class="text-muted">{{ 'features.empty_events' | t }}</p>
  {%- endif -%}
</section>
{%- endif -%}

{% stylesheet %}
  .feature-events {
    padding-bottom: var(--section-space-large);
  }

  .feature-events__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px 40px;
    padding: 0;
    list-style: none;
  }

  .feature-events__item {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  @media (max-width: 749px) {
    .feature-events__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.features_events",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.events_source"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Exhibitions and events"
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "t:labels.items_to_show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 4
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:labels.anchor",
      "info": "t:info.anchor",
      "default": "events"
    }
  ],
  "presets": [
    {
      "name": "t:general.features_events"
    }
  ]
}
{% endschema %}
