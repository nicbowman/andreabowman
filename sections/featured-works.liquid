{%- liquid
  assign source = section.settings.collection
  assign limit = section.settings.products_to_show
  assign minimum = section.settings.minimum_to_show

  # Count only products of the chosen kind, so a mixed collection never mixes paintings and pieces.
  assign kind = section.settings.kind
  assign count = 0
  for item in source.products limit: 50
    assign item_type = item.type | downcase
    assign item_kind = 'painting'
    unless item_type == blank or item_type == 'painting' or item_type == 'print'
      assign item_kind = 'piece'
    endunless
    if item_kind == kind
      assign count = count | plus: 1
    endif
  endfor
-%}

{%- if count >= minimum or request.design_mode -%}
  <section class="page-width featured-works" aria-labelledby="FeaturedWorks-{{ section.id }}">
    <div class="section-heading">
      <h2 id="FeaturedWorks-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.show_tabs -%}
        {% render 'works-tabs',
          available: section.settings.available_collection,
          sold: section.settings.sold_collection,
          current_handle: source.handle
        %}
      {%- elsif source and section.settings.view_all_label != blank -%}
        <a class="link link--icon" href="{{ source.url }}">
        {{- section.settings.view_all_label | escape -}}
        {% render 'icon', name: 'arrow-right', class: 'icon--small' %}
      </a>
      {%- endif -%}
    </div>

    {%- if count > 0 -%}
      <ul class="product-grid" role="list">
        {%- assign shown = 0 -%}
        {%- for product in source.products limit: 50 -%}
          {%- liquid
            if shown >= limit
              break
            endif
            assign item_type = product.type | downcase
            assign item_kind = 'painting'
            unless item_type == blank or item_type == 'painting' or item_type == 'print'
              assign item_kind = 'piece'
            endunless
            if item_kind != kind
              continue
            endif
            assign shown = shown | plus: 1
          -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="text-muted">{{ 'collections.empty' | t }}</p>
    {%- endif -%}
  </section>
{%- endif -%}

{% stylesheet %}
  .featured-works {
    padding-bottom: var(--section-space-large);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_works",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Available art"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection",
      "info": "t:info.featured_collection"
    },
    {
      "type": "select",
      "id": "kind",
      "label": "t:labels.kind",
      "info": "t:info.kind",
      "options": [
        { "value": "painting", "label": "t:options.kind.painting" },
        { "value": "piece", "label": "t:options.kind.piece" }
      ],
      "default": "painting"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6
    },
    {
      "type": "range",
      "id": "minimum_to_show",
      "label": "t:labels.minimum_to_show",
      "info": "t:info.minimum_to_show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:labels.view_all_label",
      "default": "View all art"
    },
    {
      "type": "header",
      "content": "t:headers.tabs"
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "t:labels.show_tabs",
      "info": "t:info.show_tabs",
      "default": false
    },
    {
      "type": "collection",
      "id": "available_collection",
      "label": "t:labels.available_collection"
    },
    {
      "type": "collection",
      "id": "sold_collection",
      "label": "t:labels.sold_collection"
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_works"
    }
  ]
}
{% endschema %}
