<section class="page-width page-intro">
  <h1 class="page-intro__heading">{{ section.settings.heading | default: page.title | escape }}</h1>

  <div class="page-intro__body">
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <nav class="page-intro__links" aria-label="{{ 'general.on_this_page' | t }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_content = true
            case block.settings.content_source
              when 'homes'
                if metaobjects.home_installation.values_count == 0
                  assign has_content = false
                endif
              when 'press'
                if metaobjects.press_article.values_count == 0
                  assign has_content = false
                endif
              when 'events'
                if metaobjects.event.values_count == 0
                  assign has_content = false
                endif
            endcase
            if request.design_mode
              assign has_content = true
            endif
          -%}
          {%- if has_content -%}
            <a class="link" href="#{{ block.settings.anchor | handleize }}" {{ block.shopify_attributes }}>
              {{- block.settings.label | escape -}}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .page-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 24px var(--block-gap);
    padding-top: var(--page-top);
    padding-bottom: var(--page-top);
  }

  .page-intro__heading {
    flex: 1 1 520px;
  }

  .page-intro__body {
    flex: 1 1 360px;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .page-intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
  }

  @media (max-width: 749px) {
    .page-intro {
      gap: 20px;
      padding-top: var(--page-top);
      padding-bottom: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page_intro",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.page_intro_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    }
  ],
  "blocks": [
    {
      "type": "anchor",
      "name": "t:general.anchor_link",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.link_label",
          "default": "Section"
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "t:labels.anchor",
          "info": "t:info.anchor"
        },
        {
          "type": "select",
          "id": "content_source",
          "label": "t:labels.content_source",
          "info": "t:info.content_source",
          "options": [
            { "value": "always", "label": "t:options.content_source.always" },
            { "value": "homes", "label": "t:options.content_source.homes" },
            { "value": "press", "label": "t:options.content_source.press" },
            { "value": "events", "label": "t:options.content_source.events" }
          ],
          "default": "always"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.page_intro"
    }
  ]
}
{% endschema %}
