<section class="page-width page-intro">
  <h1 class="page-intro__heading">{{ section.settings.heading | default: page.title | escape }}</h1>

  <div class="page-intro__body">
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <nav class="page-intro__links" aria-label="{{ 'general.on_this_page' | t }}">
        {%- for block in section.blocks -%}
          <a class="link" href="#{{ block.settings.anchor | handleize }}" {{ block.shopify_attributes }}>
            {{- block.settings.label | escape -}}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .page-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--block-gap);
    padding-top: 110px;
    padding-bottom: 80px;
  }

  .page-intro__heading {
    flex: 1 1 520px;
  }

  .page-intro__body {
    flex: 1 1 360px;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .page-intro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
  }

  @media (max-width: 749px) {
    .page-intro {
      gap: 24px;
      padding-top: 48px;
      padding-bottom: 56px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page_intro",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.page_intro_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    }
  ],
  "blocks": [
    {
      "type": "anchor",
      "name": "t:general.anchor_link",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.link_label",
          "default": "Section"
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "t:labels.anchor",
          "info": "t:info.anchor"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.page_intro"
    }
  ]
}
{% endschema %}
