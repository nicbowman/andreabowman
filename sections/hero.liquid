{%- liquid
  assign slides = '1,2,3' | split: ','
  assign filled = 0
  for n in slides
    assign key = 'image'
    if n != '1'
      assign key = 'image_' | append: n
    endif
    if section.settings[key]
      assign filled = filled | plus: 1
    endif
  endfor
-%}

<section class="hero hero--{{ section.settings.height }}" aria-label="{{ section.settings.label | escape }}" data-hero>
  {%- assign shown = 0 -%}
  {%- for n in slides -%}
    {%- liquid
      if n == '1'
        assign image = section.settings.image
        assign caption = section.settings.caption
        assign link = section.settings.caption_link
      else
        assign image_key = 'image_' | append: n
        assign caption_key = 'caption_' | append: n
        assign link_key = 'caption_link_' | append: n
        assign image = section.settings[image_key]
        assign caption = section.settings[caption_key]
        assign link = section.settings[link_key]
      endif
      if image == blank and n != '1'
        continue
      endif
      assign image_alt = image.alt | default: caption | escape
      assign caption_colour = section.settings.caption_colour
      unless image
        assign caption_colour = 'dark'
      endunless
      assign shown = shown | plus: 1
    -%}
    <div class="hero__slide" {% if shown > 1 %}hidden{% endif %}>
      {%- if image -%}
        {%- liquid
          if shown == 1
            assign loading = 'eager'
            assign priority = 'high'
          else
            assign loading = 'lazy'
            assign priority = 'auto'
          endif
        -%}
        {{
          image
          | image_url: width: 3200
          | image_tag:
            class: 'hero__image',
            widths: '750, 1100, 1500, 1800, 2200, 2600, 3200',
            sizes: '100vw',
            loading: loading,
            fetchpriority: priority,
            alt: image_alt
        }}
      {%- endif -%}

      {%- if caption != blank -%}
        <p class="hero__caption hero__caption--{{ caption_colour }}">
          <span>{{ caption | escape }}</span>
          {%- if link != blank -%}
            <a class="hero__link" href="{{ link }}">{{ section.settings.link_label | escape }}</a>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  {%- endfor -%}
</section>

{%- if filled > 1 -%}
  <script>
    (function () {
      var slides = document.currentScript.previousElementSibling.querySelectorAll('.hero__slide');
      if (slides.length < 2) return;
      var pick = Math.floor(Math.random() * slides.length);
      if (pick === 0) return;
      slides.forEach(function (slide, index) {
        slide.hidden = index !== pick;
        if (index === pick) {
          var img = slide.querySelector('img');
          if (img) {
            img.loading = 'eager';
            img.setAttribute('fetchpriority', 'high');
          }
        }
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-mount);
  }

  .hero--tall {
    height: 760px;
  }

  .hero--medium {
    height: 600px;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .hero__caption {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    padding: 40px var(--page-gutter);
    font-size: var(--text-size-caption);
    letter-spacing: 0.04em;
  }

  .hero__caption--light,
  .hero__caption--light .hero__link {
    color: var(--color-ivory);
  }

  .hero__caption--dark,
  .hero__caption--dark .hero__link {
    color: var(--color-ink);
  }

  .hero__link {
    text-underline-offset: 4px;
  }

  @media (max-width: 989px) {
    .hero--tall,
    .hero--medium {
      height: 560px;
    }
  }

  @media (max-width: 749px) {
    .hero--tall,
    .hero--medium {
      height: 460px;
    }

    .hero__caption {
      padding-block: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.hero_image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:labels.caption",
      "default": "[Featured painting title], [year]"
    },
    {
      "type": "url",
      "id": "caption_link",
      "label": "t:labels.caption_link"
    },
    {
      "type": "header",
      "content": "t:headers.hero_more"
    },
    {
      "type": "paragraph",
      "content": "t:info.hero_more"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:labels.image_2"
    },
    {
      "type": "text",
      "id": "caption_2",
      "label": "t:labels.caption_2"
    },
    {
      "type": "url",
      "id": "caption_link_2",
      "label": "t:labels.caption_link_2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "t:labels.image_3"
    },
    {
      "type": "text",
      "id": "caption_3",
      "label": "t:labels.caption_3"
    },
    {
      "type": "url",
      "id": "caption_link_3",
      "label": "t:labels.caption_link_3"
    },
    {
      "type": "header",
      "content": "t:headers.appearance"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "View painting"
    },
    {
      "type": "select",
      "id": "caption_colour",
      "label": "t:labels.caption_colour",
      "info": "t:info.caption_colour",
      "options": [
        { "value": "light", "label": "t:options.colour.light" },
        { "value": "dark", "label": "t:options.colour.dark" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:labels.height",
      "options": [
        { "value": "tall", "label": "t:options.height.tall" },
        { "value": "medium", "label": "t:options.height.medium" }
      ],
      "default": "tall"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.region_label",
      "info": "t:info.region_label",
      "default": "Featured painting"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
