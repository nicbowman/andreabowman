{%- liquid
  assign tag = section.settings.heading_tag
  if tag == 'h1'
    assign heading_class = 'h1'
  else
    assign heading_class = 'h2'
  endif
-%}

<section class="split-text split-text--{{ section.settings.background }}">
  <div class="page-width split-text__inner split-text__inner--{{ section.settings.alignment }}">
    {%- if section.settings.heading != blank -%}
      <{{ tag }} class="split-text__heading {{ heading_class }}">{{ section.settings.heading | escape }}</{{ tag }}>
    {%- endif -%}

    <div class="split-text__body">
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
        {%- case section.settings.link_style -%}
          {%- when 'primary' -%}
            <a class="button split-text__action" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>
          {%- when 'secondary' -%}
            <a class="button button--secondary split-text__action" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>
          {%- else -%}
            <a class="link split-text__action" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>
        {%- endcase -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .split-text--oatmeal {
    background-color: var(--color-oatmeal);
  }

  .split-text__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--block-gap);
    padding-block: var(--section-space-large);
  }

  .split-text__inner--end {
    align-items: flex-end;
  }

  .split-text__inner--start {
    align-items: flex-start;
  }

  .split-text__heading {
    flex: 1 1 480px;
  }

  .split-text__heading.h2 {
    line-height: 1.25;
  }

  .split-text__body {
    flex: 1 1 380px;
    max-width: 500px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .split-text__action {
    align-self: flex-start;
  }

  .button--secondary.split-text__action {
    padding: 19px 40px;
  }

  @media (max-width: 749px) {
    .split-text__heading,
    .split-text__body {
      flex-basis: 100%;
    }

    .split-text__inner {
      gap: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.split_text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:labels.heading_tag",
      "info": "t:info.heading_tag",
      "options": [
        { "value": "h1", "label": "t:options.heading_tag.page_title" },
        { "value": "h2", "label": "t:options.heading_tag.section_title" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>[Text]</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:labels.link_url"
    },
    {
      "type": "select",
      "id": "link_style",
      "label": "t:labels.link_style",
      "options": [
        { "value": "link", "label": "t:options.link_style.link" },
        { "value": "primary", "label": "t:options.link_style.primary" },
        { "value": "secondary", "label": "t:options.link_style.secondary" }
      ],
      "default": "link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.vertical_alignment",
      "options": [
        { "value": "end", "label": "t:options.vertical_alignment.bottom" },
        { "value": "start", "label": "t:options.vertical_alignment.top" }
      ],
      "default": "end"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "ivory", "label": "t:options.background.ivory" },
        { "value": "oatmeal", "label": "t:options.background.oatmeal" }
      ],
      "default": "ivory"
    }
  ],
  "presets": [
    {
      "name": "t:general.split_text"
    }
  ]
}
{% endschema %}
