<section class="page-width image-row" aria-labelledby="Heading-{{ section.id }}">
  <div class="section-heading">
    <h2 id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
  </div>

  {%- if section.blocks.size > 0 -%}
    <ul class="image-row__grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <figure class="image-row__item">
            {% render 'cover-image',
              image: block.settings.image,
              ratio: '1-1',
              alt: block.settings.caption,
              sizes: '(min-width: 1320px) 380px, (min-width: 750px) 30vw, 100vw'
            %}
            {%- if block.settings.caption != blank -%}
              <figcaption class="text-caption">{{ block.settings.caption | escape }}</figcaption>
            {%- endif -%}
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% stylesheet %}
  .image-row {
    padding-block: var(--section-space);
  }

  .image-row__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    padding: 0;
    list-style: none;
  }

  .image-row__item {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  @media (max-width: 749px) {
    .image-row__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image_row",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:labels.image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:info.lifestyle_image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:labels.caption",
          "default": "[Caption]"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:general.image_row",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
