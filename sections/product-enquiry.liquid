{%- liquid
  # A product is a painting when its product type is "Painting" or "Print" (or empty); anything else
  # (Candle, Cushion, Pot, Planter...) is a piece for Interiors or Garden.
  assign product_type = product.type | downcase
  assign is_piece = false
  unless product_type == blank or product_type == 'painting' or product_type == 'print'
    assign is_piece = true
  endunless

  assign tags_lower = product.tags | join: '|' | downcase | split: '|'
  assign is_sold = false
  if tags_lower contains 'sold'
    assign is_sold = true
  elsif is_piece and product.available == false
    assign is_sold = true
  endif

  if is_piece
    assign variant = product.selected_or_first_available_variant
    assign item_label = 'products.enquiry.piece' | t
    assign item_name = 'contact[Piece]'
    assign enquiry_type = 'products.enquiry.type_piece' | t
    assign message_placeholder = 'products.enquiry.message_placeholder_piece' | t
  else
    assign item_label = 'products.enquiry.painting' | t
    assign item_name = 'contact[Painting]'
    assign enquiry_type = 'products.enquiry.type_enquiry' | t
    assign message_placeholder = 'products.enquiry.message_placeholder' | t
  endif

  if is_sold and is_piece
    assign item_value = 'products.enquiry.sold_piece' | t: title: product.title
    assign heading = section.settings.sold_heading
  elsif is_sold
    assign item_value = 'products.enquiry.sold_painting' | t: title: product.title
    assign heading = section.settings.sold_heading
  elsif is_piece
    assign price = variant.price | money_without_trailing_zeros | strip_html
    assign item_value = product.title
    unless product.has_only_default_variant
      assign item_value = item_value | append: ', ' | append: variant.title
    endunless
    assign item_value = item_value | append: ', ' | append: price
    assign heading = section.settings.heading
  else
    assign price = product.price | money_without_trailing_zeros | strip_html
    assign item_value = product.title | append: ', ' | append: price
    assign heading = section.settings.heading
  endif

  assign delivery_options = section.settings.delivery_options | newline_to_br | split: '<br />'
-%}

{%- comment -%}
  The enquiry opens in a side panel from the Enquire and Reserve buttons (#enquire). It reopens after posting,
  so the thank-you or any errors show where the form was.
{%- endcomment -%}
{%- assign enquiry_open = false -%}
{%- capture panel_body -%}
  <div class="enquiry-summary">
    {% render 'painting-mount', image: product.featured_image, alt: product.title, sizes: '96px', class: 'enquiry-summary__image' %}
    <div class="enquiry-summary__text">
      <span class="enquiry-summary__title">{{ product.title | escape }}</span>
      <span class="enquiry-summary__meta" data-enquiry-summary>
        {%- if is_sold and is_piece -%}
          {{- 'products.sold_out' | t -}}
        {%- elsif is_sold -%}
          {{- 'products.sold' | t -}}
        {%- elsif is_piece and product.has_only_default_variant == false -%}
          {{- variant.title }}, {{ price -}}
        {%- else -%}
          {{- price -}}
        {%- endif -%}
      </span>
    </div>
  </div>

  {%- if section.settings.text != blank -%}
    <div class="rte product-enquiry__text">{{ section.settings.text }}</div>
  {%- endif -%}

    {%- form 'contact', id: 'ProductEnquiry', class: 'product-enquiry__form' -%}
      {%- if form.posted_successfully? or form.errors -%}
        {%- assign enquiry_open = true -%}
      {%- endif -%}
      {%- if form.posted_successfully? -%}
        <div class="form-sent" data-form-sent>
        <p class="form-message form-message--success" role="status">
          {%- render 'icon', name: 'check' -%}
          <span>{{ 'products.enquiry.success' | t }}</span>
        </p>
          <button type="button" class="form-sent__again" data-form-again>{{ 'contact.send_another' | t }}</button>
        </div>
      {%- endif -%}
      <div class="form-fields" data-form-fields{% if form.posted_successfully? %} hidden{% endif %}>
        {%- if form.errors -%}
          <div class="form-message" role="alert" id="ProductEnquiryErrors">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <input type="hidden" name="contact[Link]" value="{{ shop.url }}{{ product.url }}">
        <input type="hidden" name="contact[Enquiry]" value="{{ enquiry_type | escape }}">

        {%- comment -%} Shown in the summary above; sent with the enquiry so the email names the painting or piece {%- endcomment -%}
        <input type="hidden" name="{{ item_name }}" value="{{ item_value | escape }}" data-enquiry-item>
        <span class="visually-hidden">{{ item_label }}: {{ item_value | escape }}</span>

        {%- if is_piece and is_sold == false -%}
          {%- if section.settings.show_quantity or section.settings.delivery_options != blank -%}
            <div class="product-enquiry__row">
              {%- if section.settings.show_quantity -%}
                <label class="field" for="ProductEnquiry-quantity">
                  {{- 'products.enquiry.quantity' | t -}}
                  <input
                    class="field__input"
                    id="ProductEnquiry-quantity"
                    type="number"
                    name="contact[Quantity]"
                    min="1"
                    step="1"
                    inputmode="numeric"
                    value="1"
                  >
                </label>
              {%- endif -%}

              {%- if section.settings.delivery_options != blank -%}
                <label class="field" for="ProductEnquiry-delivery">
                  {{- 'products.enquiry.delivery' | t -}}
                  <select class="field__input" id="ProductEnquiry-delivery" name="contact[Delivery]">
                    {%- for option in delivery_options -%}
                      {%- assign clean_option = option | strip -%}
                      {%- if clean_option != blank -%}
                        <option value="{{ clean_option | escape }}">{{ clean_option | escape }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                </label>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        <div class="product-enquiry__row">
          <label class="field" for="ProductEnquiry-name">
            {{- 'products.enquiry.name' | t -}}
            <input
              class="field__input"
              id="ProductEnquiry-name"
              type="text"
              name="contact[name]"
              autocomplete="name"
              value="{{ form.name }}"
              required
            >
          </label>

          <label class="field" for="ProductEnquiry-email">
            {{- 'products.enquiry.email' | t -}}
            <input
              class="field__input"
              id="ProductEnquiry-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              value="{{ form.email }}"
              required
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ProductEnquiryErrors"
              {% endif %}
            >
          </label>
        </div>

        <label class="field" for="ProductEnquiry-phone">
          {{- 'products.enquiry.phone' | t -}}
          <input
            class="field__input"
            id="ProductEnquiry-phone"
            type="tel"
            name="contact[phone]"
            autocomplete="tel"
            value="{{ form.phone }}"
          >
        </label>

        <fieldset class="choice-group">
          <legend class="choice-group__legend">{{ 'forms.preferred_contact' | t }}</legend>
          <div class="choice-group__options">
            {%- assign methods = 'forms.method_email,forms.method_phone,forms.method_whatsapp' | split: ',' -%}
            {%- for method in methods -%}
              {%- assign method_label = method | t -%}
              <label class="choice" for="ProductEnquiry-method-{{ forloop.index }}">
                <input
                  type="radio"
                  id="ProductEnquiry-method-{{ forloop.index }}"
                  name="contact[Preferred contact]"
                  value="{{ method_label | escape }}"
                  {% if forloop.first %}
                    checked
                  {% endif %}
                >
                <span>{{ method_label }}</span>
              </label>
            {%- endfor -%}
          </div>
        </fieldset>

        <label class="field" for="ProductEnquiry-message">
          {{- 'products.enquiry.message' | t -}}
          <textarea
            class="field__input"
            id="ProductEnquiry-message"
            name="contact[body]"
            rows="3"
            placeholder="{{ message_placeholder | escape }}"
          >
            {%- unless form.posted_successfully? -%}{{- form.body -}}{%- endunless -%}
          </textarea>
        </label>

        <button class="button product-enquiry__submit" type="submit">{{ 'products.enquiry.submit' | t }}</button>
        {% render 'consent-note' %}
      </div>
    {%- endform -%}
{%- endcapture -%}

{% render 'side-panel', id: 'enquire', title: heading, content: panel_body, form_id: 'ProductEnquiry', open: enquiry_open %}

{% stylesheet %}
  .product-enquiry__text p {
    color: var(--color-ink-soft);
    font-size: var(--text-size-small);
  }

  .product-enquiry__row {
    display: flex;
    flex-wrap: wrap;
    gap: 26px 24px;
  }

  .product-enquiry__row .field {
    flex: 1 1 160px;
  }

  .product-enquiry__submit {
    padding: 22px 44px;
  }

  .product-enquiry .field__input::placeholder {
    color: var(--color-muted);
    opacity: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_enquiry",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Enquire about this painting"
    },
    {
      "type": "text",
      "id": "sold_heading",
      "label": "t:labels.sold_heading",
      "info": "t:info.sold_heading",
      "default": "Ask about commissions or similar works"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Ask about the work, arrange a viewing or reserve it for a project. Andrea replies personally [within two working days].</p>"
    },
    {
      "type": "header",
      "content": "t:headers.pieces"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "t:labels.show_quantity",
      "default": true
    },
    {
      "type": "textarea",
      "id": "delivery_options",
      "label": "t:labels.delivery_options",
      "info": "t:info.delivery_options"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
