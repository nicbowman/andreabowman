<footer class="site-footer">
  <div class="page-width site-footer__bar">
    <span class="site-footer__name">{{ shop.name }}</span>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    background-color: var(--color-moss);
    color: var(--color-on-moss-soft);
  }
  .site-footer__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-block: 56px;
    font-size: 13px;
  }
  .site-footer__name {
    color: var(--color-on-moss);
    text-transform: uppercase;
    letter-spacing: 0.3em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": []
}
{% endschema %}
