{% comment %}
  Holding version of the painting page. Enquiry only: no product form, no cart, no checkout.
  The full painting page (mount, thumbnails, details, enquiry form) replaces this in feature/product-page.
{% endcomment %}

<div class="page-width section">
  <h1>{{ product.title }}</h1>
  {%- if product.tags contains 'sold' -%}
    <p class="text-muted">{{ 'products.sold' | t }}</p>
  {%- else -%}
    <p>{{ product.price | money }}</p>
  {%- endif -%}
  <div class="rte">{{ product.description }}</div>
</div>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
