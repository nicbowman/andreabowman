{%- liquid
  assign tags_lower = product.tags | join: '|' | downcase | split: '|'
  assign is_sold = false
  if tags_lower contains 'sold'
    assign is_sold = true
  endif

  if is_sold and section.settings.sold_collection
    assign crumb = section.settings.sold_collection
  else
    assign crumb = section.settings.works_collection
  endif

  assign full_image = product.images[0]
  assign detail_image = product.images[1]
  assign room_image = product.metafields.custom.in_room_image.value
  assign year = product.metafields.custom.year.value

  assign view_count = 0
  if full_image
    assign view_count = view_count | plus: 1
  endif
  if detail_image
    assign view_count = view_count | plus: 1
  endif
  if room_image
    assign view_count = view_count | plus: 1
  endif

  assign main_sizes = '(min-width: 1320px) 680px, (min-width: 990px) 55vw, 100vw'
  assign thumb_sizes = '(min-width: 1320px) 210px, (min-width: 990px) 17vw, 30vw'
  assign detail_alt = 'products.alt_detail' | t: title: product.title
  assign room_alt = 'products.alt_in_room' | t: title: product.title
-%}

{%- if crumb -%}
  <nav class="page-width product-crumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
    <a href="{{ crumb.url }}">{{ crumb.title | escape }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ product.title | escape }}</span>
  </nav>
{%- endif -%}

<div class="page-width product">
  <div class="product__gallery" data-gallery>
    <div class="product__stage">
      <div id="ProductView-full-{{ section.id }}" class="product__view is-active">
        {%- if full_image -%}
          <a
            class="product__zoom"
            href="{{ full_image | image_url: width: 2400 }}"
            data-zoom
            data-zoom-alt="{{ product.title | escape }}"
            aria-label="{{ 'products.zoom' | t: view: product.title | escape }}"
          >
            {% render 'painting-mount', image: full_image, alt: product.title, eager: true, sizes: main_sizes %}
          </a>
        {%- else -%}
          {% render 'painting-mount', image: full_image, alt: product.title, eager: true, sizes: main_sizes %}
        {%- endif -%}
      </div>

      {%- if detail_image -%}
        <div id="ProductView-detail-{{ section.id }}" class="product__view" hidden>
          <a
            class="product__zoom product__frame"
            href="{{ detail_image | image_url: width: 2400 }}"
            data-zoom
            data-zoom-alt="{{ detail_alt | escape }}"
            aria-label="{{ 'products.zoom' | t: view: detail_alt | escape }}"
          >
            {{
              detail_image
              | image_url: width: 2000
              | image_tag:
                widths: '400, 600, 800, 1000, 1200, 1500, 2000',
                sizes: main_sizes,
                loading: 'lazy',
                alt: detail_alt
            }}
          </a>
        </div>
      {%- endif -%}

      {%- if room_image -%}
        <div id="ProductView-room-{{ section.id }}" class="product__view" hidden>
          <a
            class="product__zoom product__frame"
            href="{{ room_image | image_url: width: 2400 }}"
            data-zoom
            data-zoom-alt="{{ room_alt | escape }}"
            aria-label="{{ 'products.zoom' | t: view: room_alt | escape }}"
          >
            {{
              room_image
              | image_url: width: 2000
              | image_tag:
                widths: '400, 600, 800, 1000, 1200, 1500, 2000',
                sizes: main_sizes,
                loading: 'lazy',
                alt: room_alt
            }}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- if view_count > 1 -%}
      <ul class="product__thumbs" role="list" aria-label="{{ 'products.views' | t }}">
        <li class="product__thumb">
          <button
            type="button"
            class="product__thumb-button"
            aria-controls="ProductView-full-{{ section.id }}"
            aria-pressed="true"
            data-gallery-thumb
          >
            {% render 'painting-mount', image: full_image, alt: product.title, sizes: thumb_sizes %}
            <span class="product__thumb-label">{{ 'products.view_full' | t }}</span>
          </button>
        </li>

        {%- if detail_image -%}
          <li class="product__thumb">
            <button
              type="button"
              class="product__thumb-button"
              aria-controls="ProductView-detail-{{ section.id }}"
              aria-pressed="false"
              data-gallery-thumb
            >
              <span class="product__frame">
                {{
                  detail_image
                  | image_url: width: 600
                  | image_tag: widths: '200, 300, 400, 600', sizes: thumb_sizes, loading: 'lazy', alt: detail_alt
                }}
              </span>
              <span class="product__thumb-label">{{ 'products.view_detail' | t }}</span>
            </button>
          </li>
        {%- endif -%}

        {%- if room_image -%}
          <li class="product__thumb">
            <button
              type="button"
              class="product__thumb-button"
              aria-controls="ProductView-room-{{ section.id }}"
              aria-pressed="false"
              data-gallery-thumb
            >
              <span class="product__frame">
                {{
                  room_image
                  | image_url: width: 600
                  | image_tag: widths: '200, 300, 400, 600', sizes: thumb_sizes, loading: 'lazy', alt: room_alt
                }}
              </span>
              <span class="product__thumb-label">{{ 'products.view_in_room' | t }}</span>
            </button>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="product__info">
    <div class="product__heading">
      <h1>{{ product.title | escape }}</h1>
      {%- if year != blank -%}
        <span class="product__year">{{ year | escape }}</span>
      {%- endif -%}
    </div>

    {%- if is_sold -%}
      <span class="product__sold">{{ 'products.sold' | t }}</span>
    {%- else -%}
      <span class="product__price">{{ product.price | money_without_trailing_zeros }}</span>
    {%- endif -%}

    {%- liquid
      assign medium = product.metafields.custom.medium.value
      assign dimensions = product.metafields.custom.dimensions.value
      assign framing = product.metafields.custom.framing.value
      assign signature = product.metafields.custom.signature.value
    -%}
    {%- if medium != blank or dimensions != blank or framing != blank or signature != blank -%}
      <dl class="product__details">
        {%- if medium != blank -%}
          <div class="product__detail">
            <dt>{{ 'products.medium' | t }}</dt>
            <dd>{{ medium | escape }}</dd>
          </div>
        {%- endif -%}
        {%- if dimensions != blank -%}
          <div class="product__detail">
            <dt>{{ 'products.dimensions' | t }}</dt>
            <dd>{{ dimensions | escape }}</dd>
          </div>
        {%- endif -%}
        {%- if framing != blank -%}
          <div class="product__detail">
            <dt>{{ 'products.framing' | t }}</dt>
            <dd>{{ framing | escape }}</dd>
          </div>
        {%- endif -%}
        {%- if signature != blank -%}
          <div class="product__detail">
            <dt>{{ 'products.signature' | t }}</dt>
            <dd>{{ signature | escape }}</dd>
          </div>
        {%- endif -%}
      </dl>
    {%- endif -%}

    {%- if is_sold -%}
      <p class="product__sold-message">
        {{ section.settings.sold_message | escape }}
        <a href="#enquire">{{ section.settings.sold_link_text | escape }}</a>
      </p>
    {%- else -%}
      <div class="product__actions">
        <a class="button button--full" href="#enquire" data-enquire>{{ 'products.enquire' | t }}</a>
        <a
          class="button button--secondary button--full"
          href="#enquire"
          data-enquire
          data-reserve="{{ 'products.reserve_message' | t | escape }}"
        >
          {{- 'products.reserve' | t -}}
        </a>
      </div>

      {%- if section.settings.shipping_note != blank -%}
        <p class="product__shipping">{{ section.settings.shipping_note | escape }}</p>
      {%- endif -%}
    {%- endif -%}

    {%- if product.description != blank -%}
      <div class="product__about">
        <h2 class="product__about-heading">{{ 'products.about' | t }}</h2>
        <div class="rte">{{ product.description }}</div>
      </div>
    {%- endif -%}
  </div>
</div>

<dialog class="lightbox" data-lightbox aria-label="{{ 'products.zoom_dialog' | t }}">
  <button type="button" class="lightbox__close" data-lightbox-close>{{ 'products.zoom_close' | t }}</button>
  <div class="lightbox__stage" data-lightbox-stage></div>
  <p class="lightbox__hint">{{ 'products.zoom_hint' | t }}</p>
</dialog>

{% javascript %}
  (function () {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* Thumbnails crossfade the main view in place. Without JS the first view simply stays visible. */
    document.querySelectorAll('[data-gallery]').forEach(function (gallery) {
      gallery.classList.add('is-enhanced');
      gallery.querySelectorAll('.product__view').forEach(function (view) {
        view.hidden = false;
        view.setAttribute('aria-hidden', view.classList.contains('is-active') ? 'false' : 'true');
        if (!view.classList.contains('is-active')) {
          view.querySelectorAll('a').forEach(function (link) { link.setAttribute('tabindex', '-1'); });
        }
      });
    });

    function showView(thumb) {
      var gallery = thumb.closest('[data-gallery]');
      var targetId = thumb.getAttribute('aria-controls');
      gallery.querySelectorAll('.product__view').forEach(function (view) {
        var active = view.id === targetId;
        view.classList.toggle('is-active', active);
        view.setAttribute('aria-hidden', active ? 'false' : 'true');
        view.querySelectorAll('a').forEach(function (link) {
          if (active) link.removeAttribute('tabindex'); else link.setAttribute('tabindex', '-1');
        });
      });
      gallery.querySelectorAll('[data-gallery-thumb]').forEach(function (button) {
        button.setAttribute('aria-pressed', button === thumb ? 'true' : 'false');
      });
    }

    /* Lightbox: a modal dialog traps focus natively; Escape and the backdrop close it. */
    var dialog = document.querySelector('[data-lightbox]');
    var image = null;
    if (dialog) {
      image = document.createElement('img');
      image.className = 'lightbox__image';
      image.alt = '';
      image.tabIndex = 0;
      image.setAttribute('role', 'button');
      image.setAttribute('aria-pressed', 'false');
      dialog.querySelector('[data-lightbox-stage]').appendChild(image);
    }

    function toggleZoom(originX, originY) {
      image.style.transformOrigin = originX * 100 + '% ' + originY * 100 + '%';
      var zoomed = dialog.classList.toggle('is-zoomed');
      image.setAttribute('aria-pressed', zoomed ? 'true' : 'false');
    }
    var opener = null;

    function openLightbox(link) {
      if (!dialog || typeof dialog.showModal !== 'function') return false;
      opener = link;
      image.src = link.getAttribute('href');
      image.alt = link.getAttribute('data-zoom-alt') || '';
      image.setAttribute('aria-pressed', 'false');
      dialog.classList.remove('is-closing', 'is-zoomed');
      dialog.showModal();
      return true;
    }

    function closeLightbox() {
      if (!dialog || !dialog.open) return;
      var finish = function () {
        dialog.classList.remove('is-closing', 'is-zoomed');
        dialog.close();
        if (opener) opener.focus();
      };
      if (reduceMotion.matches) {
        finish();
        return;
      }
      dialog.classList.add('is-closing');
      window.setTimeout(finish, 300);
    }

    if (dialog) {
      dialog.addEventListener('cancel', function (event) {
        event.preventDefault();
        closeLightbox();
      });
      dialog.addEventListener('click', function (event) {
        if (event.target === dialog || event.target.closest('[data-lightbox-close]')) {
          closeLightbox();
          return;
        }
        if (event.target === image) {
          var rect = image.getBoundingClientRect();
          toggleZoom((event.clientX - rect.left) / rect.width, (event.clientY - rect.top) / rect.height);
        }
      });
      dialog.addEventListener('keydown', function (event) {
        if (event.target === image && (event.key === 'Enter' || event.key === ' ')) {
          event.preventDefault();
          toggleZoom(0.5, 0.5);
          return;
        }
        if (event.key !== 'Tab') return;
        var focusables = [dialog.querySelector('[data-lightbox-close]'), image];
        var index = focusables.indexOf(document.activeElement);
        var next = event.shiftKey ? index - 1 : index + 1;
        if (next < 0) next = focusables.length - 1;
        if (next >= focusables.length) next = 0;
        event.preventDefault();
        focusables[next].focus();
      });
      dialog.addEventListener('pointermove', function (event) {
        if (!dialog.classList.contains('is-zoomed') || event.pointerType === 'touch') return;
        var rect = image.getBoundingClientRect();
        var x = Math.min(Math.max((event.clientX - rect.left) / rect.width, 0), 1);
        var y = Math.min(Math.max((event.clientY - rect.top) / rect.height, 0), 1);
        image.style.transformOrigin = x * 100 + '% ' + y * 100 + '%';
      });
    }

    document.addEventListener('click', function (event) {
      var zoom = event.target.closest('[data-zoom]');
      if (zoom) {
        if (openLightbox(zoom)) event.preventDefault();
        return;
      }

      var thumb = event.target.closest('[data-gallery-thumb]');
      if (thumb) {
        showView(thumb);
        return;
      }

      var enquire = event.target.closest('[data-enquire]');
    if (!enquire) return;
    var form = document.getElementById('ProductEnquiry');
    if (!form) return;
    var message = form.querySelector('textarea[name="contact[body]"]');
    var reserveText = enquire.getAttribute('data-reserve');
    if (message && reserveText && message.value.trim() === '') {
      message.value = reserveText;
    }
    var name = form.querySelector('input[name="contact[name]"]');
    if (name) {
      window.setTimeout(function () {
        name.focus({ preventScroll: true });
      }, 0);
    }
    });
  })();
{% endjavascript %}

{% stylesheet %}
  .product-crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 8px;
    padding-bottom: 40px;
    font-size: var(--text-size-label);
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .product-crumb a {
    color: var(--color-muted);
    text-underline-offset: 4px;
  }

  .product {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--block-gap);
    padding-bottom: var(--section-space);
  }

  .product__gallery {
    flex: 999 1 600px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .product__frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-mount);
  }

  .product__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .product__stage {
    display: grid;
  }

  .product__view {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .is-enhanced .product__view {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-swap) var(--ease-out),
      visibility 0s linear var(--dur-swap);
  }

  .is-enhanced .product__view.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--dur-swap) var(--ease-out);
  }

  .product__zoom {
    display: block;
    cursor: zoom-in;
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 56px var(--page-gutter) 40px;
    border: 0;
    background-color: var(--color-ivory);
    color: var(--color-ink);
  }

  .lightbox[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    animation: lightbox-in var(--dur-swap) var(--ease-out) both;
  }

  .lightbox.is-closing {
    animation: lightbox-out var(--dur-swap) var(--ease-out) both;
  }

  .lightbox::backdrop {
    background-color: var(--color-ivory);
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes lightbox-out {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: scale(0.98);
    }
  }

  .lightbox__close {
    position: absolute;
    top: 16px;
    right: var(--page-gutter);
    padding: 8px 0;
    border: 0;
    background: none;
    font-size: var(--text-size-caption);
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .lightbox__stage {
    flex: 1;
    min-height: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .lightbox__image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: zoom-in;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .lightbox.is-zoomed .lightbox__image {
    transform: scale(2.2);
    cursor: zoom-out;
  }

  .lightbox__hint {
    font-size: var(--text-size-label);
    color: var(--color-muted);
  }

  .product__thumbs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    padding: 0;
    list-style: none;
  }

  .product__thumb-button {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }

  .product__thumb-button > .mount,
  .product__thumb-button > .product__frame {
    outline: 1px solid transparent;
    outline-offset: 4px;
    transition: outline-color 0.2s ease;
  }

  .product__thumb-button[aria-pressed='true'] > .mount,
  .product__thumb-button[aria-pressed='true'] > .product__frame {
    outline-color: var(--color-ink);
  }

  .product__thumb-button:hover > .mount,
  .product__thumb-button:hover > .product__frame {
    outline-color: var(--color-hairline);
  }

  .product__thumb-button[aria-pressed='true']:hover > .mount,
  .product__thumb-button[aria-pressed='true']:hover > .product__frame {
    outline-color: var(--color-ink);
  }

  .product__thumb-label {
    font-size: var(--text-size-label);
    color: var(--color-muted);
  }

  .product__info {
    flex: 1 1 380px;
    max-width: 470px;
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  .product__heading {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .product__year {
    font-size: var(--text-size-small);
    color: var(--color-muted);
  }

  .product__price {
    font-size: 22px;
    font-weight: var(--font-weight-regular);
  }

  .product__sold {
    font-size: var(--text-size-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .product__details {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-hairline);
  }

  .product__detail {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .product__detail dt {
    font-size: var(--text-size-small);
    color: var(--color-muted);
  }

  .product__detail dd {
    margin: 0;
    text-align: right;
  }

  .product__actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .product__actions .button {
    padding: 22px 32px;
  }

  .product__actions .button--secondary {
    padding: 21px 32px;
  }

  .product__shipping {
    font-size: var(--text-size-small);
    color: var(--color-ink-soft);
  }

  .product__sold-message {
    color: var(--color-ink-soft);
  }

  .product__sold-message a {
    white-space: nowrap;
  }

  .product__about {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 8px;
  }

  .product__about-heading {
    font-size: 19px;
    font-weight: var(--font-weight-regular);
    line-height: 1.4;
  }

  @media (max-width: 989px) {
    .product__info {
      max-width: none;
    }
  }

  @media (max-width: 749px) {
    .product-crumb {
      padding-bottom: 28px;
    }

    .product__thumbs {
      gap: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "collection",
      "id": "works_collection",
      "label": "t:labels.works_collection",
      "info": "t:info.breadcrumb_collection"
    },
    {
      "type": "collection",
      "id": "sold_collection",
      "label": "t:labels.sold_collection",
      "info": "t:info.breadcrumb_sold_collection"
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "t:labels.shipping_note",
      "default": "Delivered by insured courier within South Africa. International shipping is quoted on request."
    },
    {
      "type": "header",
      "content": "t:headers.sold_paintings"
    },
    {
      "type": "text",
      "id": "sold_message",
      "label": "t:labels.sold_message",
      "default": "This painting has found a home."
    },
    {
      "type": "text",
      "id": "sold_link_text",
      "label": "t:labels.sold_link_text",
      "default": "Enquire about commissions or similar works."
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
