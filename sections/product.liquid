{%- liquid
  # A product is a painting when its product type is "Painting" or "Print" (or empty); anything else
  # (Candle, Cushion, Pot, Planter...) is a piece for Interiors or Garden.
  # A painting is sold when tagged "sold"; a piece is sold out when tagged "sold" or out of stock.
  assign product_type = product.type | downcase
  assign is_piece = false
  unless product_type == blank or product_type == 'painting' or product_type == 'print'
    assign is_piece = true
  endunless
  # Prints share the painting layout, but their wording says print
  assign is_print = false
  if product_type == 'print'
    assign is_print = true
  endif

  assign tags_lower = product.tags | join: '|' | downcase | split: '|'
  assign is_sold = false
  if tags_lower contains 'sold'
    assign is_sold = true
  elsif is_piece and product.available == false
    assign is_sold = true
  endif

  # A print whose stock is tracked shows how many are left, and is sold once the edition runs out
  assign prints_left = 0
  if is_print and product.variants.first.inventory_management == 'shopify'
    if product.variants.first.inventory_quantity > 0
      assign prints_left = product.variants.first.inventory_quantity
    else
      assign is_sold = true
    endif
  endif

  if is_sold and section.settings.sold_collection
    assign crumb = section.settings.sold_collection
  else
    assign crumb = section.settings.works_collection
  endif

  assign full_image = product.images[0]
  assign detail_image = product.images[1]
  assign room_image = product.metafields.custom.in_room_image.value
  assign year = product.metafields.custom.year.value
  assign variant = product.selected_or_first_available_variant

  assign lead_room = false
  if settings.lead_with_room and room_image
    assign lead_room = true
  endif
  assign first_active = true
  if lead_room
    assign first_active = false
  endif

  # Paintings: full view, surface detail, in a room. Pieces: product images plus the in-room image, four views at most.
  assign view_count = 0
  if is_piece
    assign piece_images = 4
    if room_image
      assign piece_images = 3
    endif
    assign view_count = product.images.size
    if view_count > piece_images
      assign view_count = piece_images
    endif
  else
    if full_image
      assign view_count = view_count | plus: 1
    endif
    if detail_image
      assign view_count = view_count | plus: 1
    endif
  endif
  if room_image
    assign view_count = view_count | plus: 1
  endif

  assign main_sizes = '(min-width: 1320px) 680px, (min-width: 990px) 55vw, 100vw'
  assign thumb_sizes = '(min-width: 1320px) 210px, (min-width: 990px) 17vw, 30vw'
  assign detail_alt = 'products.alt_detail' | t: title: product.title
  assign room_alt = 'products.alt_in_room' | t: title: product.title
-%}

{%- if crumb -%}
  <nav class="page-width product-crumb" aria-label="{{ 'accessibility.breadcrumb' | t }}">
    <a href="{{ crumb.url }}">{{ crumb.title | escape }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ product.title | escape }}</span>
  </nav>
{%- endif -%}

<div class="page-width product">
  <div class="product__gallery" data-gallery>
    {%- liquid
      assign full_id = 'ProductView-full-' | append: section.id
      assign detail_id = 'ProductView-detail-' | append: section.id
      assign room_id = 'ProductView-room-' | append: section.id
      assign label_full = 'products.view_full' | t
      assign label_detail = 'products.view_detail' | t
      assign label_room = 'products.view_in_room' | t
    -%}
    <div class="product__stage">
      {%- comment -%} With the lead-with-room setting, the in-room photo opens the gallery and the painting follows {%- endcomment -%}
      {%- if lead_room -%}
        {% render 'product-view', image: room_image, id: room_id, alt: room_alt, active: true, sizes: main_sizes %}
      {%- endif -%}

      {%- if is_piece -%}
        {%- comment -%} Pieces: the first image in the mount; further images and the in-room image fill a square frame {%- endcomment -%}
        {%- for image in product.images limit: piece_images -%}
          {%- liquid
            assign view_id = 'ProductView-image-' | append: forloop.index | append: '-' | append: section.id
            assign view_alt = image.alt | default: product.title
            assign view_active = false
            if forloop.first and lead_room == false
              assign view_active = true
            endif
          -%}
          {% render 'product-view',
            image: image,
            id: view_id,
            alt: view_alt,
            mounted: forloop.first,
            active: view_active,
            sizes: main_sizes
          %}
        {%- else -%}
          {% render 'product-view', id: full_id, alt: product.title, mounted: true, active: first_active, sizes: main_sizes %}
        {%- endfor -%}
      {%- else -%}
        {% render 'product-view', image: full_image, id: full_id, alt: product.title, mounted: true, active: first_active, sizes: main_sizes %}
        {%- if detail_image -%}
          {% render 'product-view', image: detail_image, id: detail_id, alt: detail_alt, sizes: main_sizes %}
        {%- endif -%}
      {%- endif -%}

      {%- if room_image and lead_room == false -%}
        {% render 'product-view', image: room_image, id: room_id, alt: room_alt, sizes: main_sizes %}
      {%- endif -%}
    </div>

    {%- if view_count > 1 -%}
      <ul
        class="product__thumbs{% if view_count > 3 %} product__thumbs--four{% endif %}"
        role="list"
        aria-label="{{ 'products.views' | t }}"
      >
        {%- if is_piece -%}
          {%- comment -%} Piece views have no fixed meaning, so the thumbnails have no captions; the alt text names each one {%- endcomment -%}
          {%- if lead_room -%}
            {% render 'product-thumb', image: room_image, controls: room_id, alt: room_alt, pressed: true, sizes: thumb_sizes %}
          {%- endif -%}
          {%- for image in product.images limit: piece_images -%}
            {%- liquid
              assign view_id = 'ProductView-image-' | append: forloop.index | append: '-' | append: section.id
              assign view_alt = image.alt | default: product.title
              assign view_active = false
              if forloop.first and lead_room == false
                assign view_active = true
              endif
            -%}
            {% render 'product-thumb',
              image: image,
              controls: view_id,
              alt: view_alt,
              mounted: forloop.first,
              pressed: view_active,
              sizes: thumb_sizes
            %}
          {%- endfor -%}
          {%- if room_image and lead_room == false -%}
            {% render 'product-thumb', image: room_image, controls: room_id, alt: room_alt, sizes: thumb_sizes %}
          {%- endif -%}
        {%- else -%}
          {%- if lead_room -%}
            {% render 'product-thumb', image: room_image, controls: room_id, alt: room_alt, label: label_room, pressed: true, sizes: thumb_sizes %}
          {%- endif -%}
          {% render 'product-thumb',
            image: full_image,
            controls: full_id,
            alt: product.title,
            label: label_full,
            mounted: true,
            pressed: first_active,
            sizes: thumb_sizes
          %}
          {%- if detail_image -%}
            {% render 'product-thumb', image: detail_image, controls: detail_id, alt: detail_alt, label: label_detail, sizes: thumb_sizes %}
          {%- endif -%}
          {%- if room_image and lead_room == false -%}
            {% render 'product-thumb', image: room_image, controls: room_id, alt: room_alt, label: label_room, sizes: thumb_sizes %}
          {%- endif -%}
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="product__info">
    <div class="product__heading">
      <h1>{{ product.title | escape }}</h1>
      {%- if year != blank and is_piece == false -%}
        <span class="product__year">{{ year | escape }}</span>
      {%- endif -%}
    </div>

    {%- if is_sold and is_piece -%}
      <span class="product__sold">{{ 'products.sold_out' | t }}</span>
    {%- elsif is_sold -%}
      <span class="product__sold">{{ 'products.sold' | t }}</span>
    {%- elsif settings.show_prices == false -%}
      <span class="product__price">{{ settings.price_label | escape }}</span>
    {%- elsif is_piece -%}
      <span class="product__price" data-variant-price>{{ variant.price | money_without_trailing_zeros }}</span>
    {%- else -%}
      <span class="product__price">{{ product.price | money_without_trailing_zeros }}</span>
    {%- endif -%}
    {%- if prints_left > 0 -%}
      <span class="product__stock">{{ 'products.prints_left' | t: count: prints_left }}</span>
    {%- endif -%}

    {%- if is_piece and product.has_only_default_variant == false -%}
      {%- comment -%}
        The options belong to the enquiry form below (form attribute), so the chosen scent or size
        is sent with the enquiry even without JavaScript. With JavaScript, the price, the link and the
        enquiry's Piece field follow the choice.
      {%- endcomment -%}
      <div class="product__options" data-variant-picker data-product-title="{{ product.title | escape }}">
        {%- for option in product.options_with_values -%}
          <fieldset class="product__option">
            <legend class="product__option-legend">{{ option.name | escape }}</legend>
            <div class="product__option-values">
              {%- for value in option.values -%}
                {%- assign value_id = 'Option-' | append: section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                <input
                  class="product__option-input visually-hidden"
                  type="radio"
                  id="{{ value_id }}"
                  name="contact[{{ option.name | escape }}]"
                  value="{{ value | escape }}"
                  form="ProductEnquiry"
                  data-option-position="{{ option.position }}"
                  {% if value.selected %}
                    checked
                  {% endif %}
                >
                <label class="product__option-value{% unless value.available %} is-unavailable{% endunless %}" for="{{ value_id }}">
                  {{- value | escape -}}
                  {%- unless value.available -%}
                    <span class="visually-hidden">, {{ 'products.sold_out' | t | downcase }}</span>
                  {%- endunless -%}
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
        <script type="application/json" data-variants>
          [
            {%- for item in product.variants -%}
              {%- liquid
                assign item_price = item.price | money_without_trailing_zeros | strip_html
                unless settings.show_prices
                  assign item_price = settings.price_label
                endunless
              -%}
              {
                "id": {{ item.id | json }},
                "title": {{ item.title | json }},
                "options": {{ item.options | json }},
                "price": {{ item_price | json }},
                "available": {{ item.available | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        </script>
      </div>
    {%- endif -%}

    {%- liquid
      assign dimensions = product.metafields.custom.dimensions.value
      if is_piece
        assign detail_keys = 'material,dimensions,finish,burn_time,wax,notes,vessel' | split: ','
      else
        assign detail_keys = 'medium,dimensions,framing,signature' | split: ','
      endif
      assign has_details = false
      for key in detail_keys
        if product.metafields.custom[key].value != blank
          assign has_details = true
          break
        endif
      endfor
    -%}
    {%- if has_details -%}
      <dl class="product__details">
        {%- for key in detail_keys -%}
          {%- assign detail_value = product.metafields.custom[key].value -%}
          {%- if detail_value != blank -%}
            {%- assign detail_label = 'products.' | append: key -%}
            <div class="product__detail">
              <dt>{{ detail_label | t }}</dt>
              <dd>{{ detail_value | escape }}</dd>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </dl>
    {%- endif -%}

    {%- if dimensions != blank and section.settings.show_scale and is_piece == false -%}
      {% render 'scale-figure', dimensions: dimensions, image: full_image, title: product.title %}
    {%- endif -%}

    {%- if is_sold -%}
      <p class="product__sold-message">
        {%- if is_print -%}
          {{ 'products.sold_message_print' | t }}
        {%- else -%}
          {{ section.settings.sold_message | escape }}
        {%- endif %}
        <a href="#enquire" data-enquire data-side-panel-open="enquire">{{ section.settings.sold_link_text | escape }}</a>
      </p>
    {%- else -%}
      <div class="product__actions">
        {%- if is_piece -%}
          <a
            class="button button--full"
            href="#enquire"
            data-enquire
            data-side-panel-open="enquire"
            data-enquiry-type="{{ 'products.enquiry.type_piece' | t | escape }}"
          >
            {{- 'products.enquire_piece' | t -}}
          </a>
        {%- else -%}
          {%- liquid
            assign enquire_key = 'products.enquire'
            assign enquiry_type_key = 'products.enquiry.type_enquiry'
            assign reserve_key = 'products.reserve_message'
            if is_print
              assign enquire_key = 'products.enquire_print'
              assign enquiry_type_key = 'products.enquiry.type_print'
              assign reserve_key = 'products.reserve_message_print'
            endif
          -%}
          <a
            class="button button--full"
            href="#enquire"
            data-enquire
            data-side-panel-open="enquire"
            data-enquiry-type="{{ enquiry_type_key | t | escape }}"
          >
            {{- enquire_key | t -}}
          </a>
          <a
            class="button button--secondary button--full"
            href="#enquire"
            data-enquire
            data-side-panel-open="enquire"
            data-enquiry-type="{{ 'products.enquiry.type_reserve' | t | escape }}"
            data-reserve="{{ reserve_key | t | escape }}"
          >
            {{- 'products.reserve' | t -}}
          </a>
        {%- endif -%}
      </div>

      {%- assign reassurance = section.settings.reassurance | newline_to_br | split: '<br />' -%}
      {%- if section.settings.reassurance != blank -%}
        <ul class="product__reassurance" role="list">
          {%- for line in reassurance -%}
            {%- assign clean_line = line | strip -%}
            {%- if clean_line != blank -%}
              {%- liquid
                assign key = clean_line | downcase
                assign line_icon = 'check'
                if key contains 'certificate' or key contains 'authentic'
                  assign line_icon = 'certificate'
                elsif key contains 'payment' or key contains 'pay ' or key contains 'eft'
                  assign line_icon = 'lock'
                elsif key contains 'view' or key contains 'appointment' or key contains 'visit'
                  assign line_icon = 'eye'
                elsif key contains 'deliver' or key contains 'courier' or key contains 'ship'
                  assign line_icon = 'truck'
                elsif key contains 'collect' or key contains 'studio'
                  assign line_icon = 'pin'
                elsif key contains 'frame' or key contains 'hang'
                  assign line_icon = 'frame'
                elsif key contains 'commission'
                  assign line_icon = 'palette'
                endif
              -%}
              <li>
                {%- render 'icon', name: line_icon -%}
                <span>{{ clean_line | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.shipping_note != blank -%}
        <p class="product__shipping">
          {%- render 'icon', name: 'truck' -%}
          <span>{{ section.settings.shipping_note | escape }}</span>
        </p>
      {%- endif -%}
    {%- endif -%}

    {%- if product.description != blank -%}
      <div class="product__about">
        <h2 class="product__about-heading">
          {%- if is_piece -%}
            {{- 'products.about_piece' | t -}}
          {%- else -%}
            {{- 'products.about' | t -}}
          {%- endif -%}
        </h2>
        <div class="rte">{{ product.description }}</div>
      </div>
    {%- endif -%}

    {%- assign care = product.metafields.custom.care.value -%}
    {%- if is_piece and care != blank -%}
      <div class="product__about">
        <h2 class="product__about-heading">{{ 'products.care' | t }}</h2>
        <div class="rte">{{ care | escape | newline_to_br }}</div>
      </div>
    {%- endif -%}
  </div>
</div>

<dialog class="lightbox" data-lightbox aria-label="{{ 'products.zoom_dialog' | t }}">
  <button type="button" class="lightbox__close" data-lightbox-close>
    {%- render 'icon', name: 'close' -%}
    {{- 'products.zoom_close' | t -}}
  </button>
  <div class="lightbox__stage" data-lightbox-stage></div>
  <p class="lightbox__hint">{{ 'products.zoom_hint' | t }}</p>
</dialog>

{% javascript %}
  (function () {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* Thumbnails crossfade the main view in place. Without JS the first view simply stays visible. */
    document.querySelectorAll('[data-gallery]').forEach(function (gallery) {
      gallery.classList.add('is-enhanced');
      gallery.querySelectorAll('.product__view').forEach(function (view) {
        view.hidden = false;
        view.setAttribute('aria-hidden', view.classList.contains('is-active') ? 'false' : 'true');
        if (!view.classList.contains('is-active')) {
          view.querySelectorAll('a').forEach(function (link) { link.setAttribute('tabindex', '-1'); });
        }
      });
    });

    function showView(thumb) {
      var gallery = thumb.closest('[data-gallery]');
      var targetId = thumb.getAttribute('aria-controls');
      gallery.querySelectorAll('.product__view').forEach(function (view) {
        var active = view.id === targetId;
        view.classList.toggle('is-active', active);
        view.setAttribute('aria-hidden', active ? 'false' : 'true');
        view.querySelectorAll('a').forEach(function (link) {
          if (active) link.removeAttribute('tabindex'); else link.setAttribute('tabindex', '-1');
        });
      });
      gallery.querySelectorAll('[data-gallery-thumb]').forEach(function (button) {
        button.setAttribute('aria-pressed', button === thumb ? 'true' : 'false');
      });
    }

    /* Piece options: the price, the page link and the enquiry's Piece field follow the choice. */
    document.querySelectorAll('[data-variant-picker]').forEach(function (picker) {
      var data = picker.querySelector('[data-variants]');
      if (!data) return;
      var variants = JSON.parse(data.textContent);
      var price = document.querySelector('[data-variant-price]');

      picker.addEventListener('change', function () {
        var chosen = [];
        picker.querySelectorAll('input:checked').forEach(function (input) {
          chosen[Number(input.getAttribute('data-option-position')) - 1] = input.value;
        });
        var match = variants.find(function (item) {
          return item.options.every(function (value, index) { return value === chosen[index]; });
        });
        if (!match) return;

        if (price && price.textContent !== match.price) {
          price.textContent = match.price;
          if (!reduceMotion.matches && price.animate) {
            price.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, easing: 'cubic-bezier(0.33, 0, 0.2, 1)' });
          }
        }

        var url = new URL(window.location.href);
        url.searchParams.set('variant', match.id);
        window.history.replaceState(window.history.state, '', url);

        var field = document.querySelector('[data-enquiry-item]');
        if (field) field.value = [picker.getAttribute('data-product-title'), match.title, match.price].join(', ');
        var summary = document.querySelector('[data-enquiry-summary]');
        if (summary) summary.textContent = match.title + ', ' + match.price;
      });
    });

    /* Lightbox: a modal dialog traps focus natively; Escape and the backdrop close it. */
    var dialog = document.querySelector('[data-lightbox]');
    var image = null;
    if (dialog) {
      image = document.createElement('img');
      image.className = 'lightbox__image';
      image.alt = '';
      image.tabIndex = 0;
      image.setAttribute('role', 'button');
      image.setAttribute('aria-pressed', 'false');
      dialog.querySelector('[data-lightbox-stage]').appendChild(image);
    }

    function toggleZoom(originX, originY) {
      image.style.transformOrigin = originX * 100 + '% ' + originY * 100 + '%';
      var zoomed = dialog.classList.toggle('is-zoomed');
      image.setAttribute('aria-pressed', zoomed ? 'true' : 'false');
    }
    var opener = null;

    function openLightbox(link) {
      if (!dialog || typeof dialog.showModal !== 'function') return false;
      opener = link;
      image.src = link.getAttribute('href');
      image.alt = link.getAttribute('data-zoom-alt') || '';
      image.setAttribute('aria-pressed', 'false');
      dialog.classList.remove('is-closing', 'is-zoomed');
      dialog.showModal();
      return true;
    }

    function closeLightbox() {
      if (!dialog || !dialog.open) return;
      var finish = function () {
        dialog.classList.remove('is-closing', 'is-zoomed');
        dialog.close();
        if (opener) opener.focus();
      };
      if (reduceMotion.matches) {
        finish();
        return;
      }
      dialog.classList.add('is-closing');
      window.setTimeout(finish, 450);
    }

    if (dialog) {
      dialog.addEventListener('cancel', function (event) {
        event.preventDefault();
        closeLightbox();
      });
      dialog.addEventListener('click', function (event) {
        if (event.target === dialog || event.target.closest('[data-lightbox-close]')) {
          closeLightbox();
          return;
        }
        if (event.target === image) {
          var rect = image.getBoundingClientRect();
          toggleZoom((event.clientX - rect.left) / rect.width, (event.clientY - rect.top) / rect.height);
        }
      });
      dialog.addEventListener('keydown', function (event) {
        if (event.target === image && (event.key === 'Enter' || event.key === ' ')) {
          event.preventDefault();
          toggleZoom(0.5, 0.5);
          return;
        }
        if (event.key !== 'Tab') return;
        var focusables = [dialog.querySelector('[data-lightbox-close]'), image];
        var index = focusables.indexOf(document.activeElement);
        var next = event.shiftKey ? index - 1 : index + 1;
        if (next < 0) next = focusables.length - 1;
        if (next >= focusables.length) next = 0;
        event.preventDefault();
        focusables[next].focus();
      });
      dialog.addEventListener('pointermove', function (event) {
        if (!dialog.classList.contains('is-zoomed') || event.pointerType === 'touch') return;
        var rect = image.getBoundingClientRect();
        var x = Math.min(Math.max((event.clientX - rect.left) / rect.width, 0), 1);
        var y = Math.min(Math.max((event.clientY - rect.top) / rect.height, 0), 1);
        image.style.transformOrigin = x * 100 + '% ' + y * 100 + '%';
      });
    }

    document.addEventListener('click', function (event) {
      var zoom = event.target.closest('[data-zoom]');
      if (zoom) {
        if (openLightbox(zoom)) event.preventDefault();
        return;
      }

      var thumb = event.target.closest('[data-gallery-thumb]');
      if (thumb) {
        showView(thumb);
        return;
      }

      var enquire = event.target.closest('[data-enquire]');
    if (!enquire) return;
    var form = document.getElementById('ProductEnquiry');
    if (!form) return;
    var message = form.querySelector('textarea[name="contact[body]"]');
    var typeField = form.querySelector('input[name="contact[Enquiry]"]');
    if (typeField && enquire.getAttribute('data-enquiry-type')) {
      typeField.value = enquire.getAttribute('data-enquiry-type');
    }
    var reserveText = enquire.getAttribute('data-reserve');
    if (message && reserveText && message.value.trim() === '') {
      message.value = reserveText;
    }
    var name = form.querySelector('input[name="contact[name]"]');
    if (name) {
      window.setTimeout(function () {
        name.focus({ preventScroll: true });
      }, 0);
    }
    });

    /* Keep the details column in view while the images scroll, but only when it fits on screen. */
    var info = document.querySelector('.product__info');
    if (info) {
      var fitSticky = function () {
        var header = document.querySelector('.shopify-section-group-header-group');
        var headerHeight = header ? header.getBoundingClientRect().height : 0;
        info.classList.toggle('is-sticky', info.offsetHeight + headerHeight + 48 < window.innerHeight);
      };
      fitSticky();
      window.addEventListener('resize', fitSticky);
    }
  })();
{% endjavascript %}

{% stylesheet %}
  .product-crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 4px;
    padding-bottom: 20px;
    font-size: var(--text-size-label);
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .product-crumb a {
    color: var(--color-muted);
    text-underline-offset: 4px;
  }

  .product {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--block-gap);
    padding-bottom: var(--section-space);
  }

  .product__gallery {
    flex: 999 1 600px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .product__frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-mount);
  }

  .product__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .product__stage {
    display: grid;
  }

  .product__view {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .is-enhanced .product__view {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-swap) var(--ease-fade),
      visibility 0s linear var(--dur-swap);
  }

  .is-enhanced .product__view.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--dur-swap) var(--ease-fade);
  }

  .product__zoom {
    position: relative;
    display: block;
    cursor: zoom-in;
  }

  /* A quiet zoom mark in the corner of the mount, so it is clear the painting can be seen up close */
  .product__zoom-hint {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: flex;
    padding: 10px;
    background-color: var(--color-ivory);
    color: var(--color-ink);
    opacity: 0.72;
    transition: opacity var(--dur-fast) var(--ease-fade);
  }

  .product__zoom:hover .product__zoom-hint,
  .product__zoom:focus-visible .product__zoom-hint {
    opacity: 1;
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 56px var(--page-gutter) 40px;
    border: 0;
    background-color: var(--color-ivory);
    color: var(--color-ink);
  }

  .lightbox[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    animation: lightbox-in var(--dur-swap) var(--ease-out) both;
  }

  .lightbox.is-closing {
    animation: lightbox-out var(--dur-swap) var(--ease-fade) both;
  }

  .lightbox::backdrop {
    background-color: var(--color-ivory);
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes lightbox-out {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: scale(0.98);
    }
  }

  .lightbox__close {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    position: absolute;
    top: 16px;
    right: var(--page-gutter);
    padding: 8px 0;
    border: 0;
    background: none;
    font-size: var(--text-size-caption);
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .lightbox__stage {
    flex: 1;
    min-height: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .lightbox__image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: zoom-in;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .lightbox.is-zoomed .lightbox__image {
    transform: scale(2.2);
    cursor: zoom-out;
  }

  .lightbox__hint {
    font-size: var(--text-size-label);
    color: var(--color-muted);
  }

  .product__thumbs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    padding: 0;
    list-style: none;
  }

  .product__thumbs--four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .product__thumb-button {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }

  .product__thumb-button > .mount,
  .product__thumb-button > .product__frame {
    outline: 1px solid transparent;
    outline-offset: 4px;
    transition: outline-color 0.2s ease;
  }

  .product__thumb-button[aria-pressed='true'] > .mount,
  .product__thumb-button[aria-pressed='true'] > .product__frame {
    outline-color: var(--color-ink);
  }

  .product__thumb-button:hover > .mount,
  .product__thumb-button:hover > .product__frame {
    outline-color: var(--color-hairline);
  }

  .product__thumb-button[aria-pressed='true']:hover > .mount,
  .product__thumb-button[aria-pressed='true']:hover > .product__frame {
    outline-color: var(--color-ink);
  }

  .product__thumb-label {
    font-size: var(--text-size-label);
    color: var(--color-muted);
  }

  .product__info {
    flex: 1 1 380px;
    max-width: 470px;
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  .product__heading {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .product__year {
    font-size: var(--text-size-small);
    color: var(--color-muted);
  }

  .product__price {
    font-size: 22px;
    font-weight: var(--font-weight-regular);
  }

  .product__stock {
    font-size: var(--text-size-small);
    color: var(--color-muted);
  }

  .product__sold {
    font-size: var(--text-size-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-sold);
  }

  /* Piece options: quiet text pills with a hairline border, ink when chosen */
  .product__options {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .product__option {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .product__option-legend {
    margin-bottom: 12px;
    padding: 0;
    font-size: var(--text-size-small);
    color: var(--color-muted);
  }

  .product__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .product__option-value {
    padding: 10px 18px;
    border: 1px solid var(--color-hairline);
    font-size: var(--text-size-small);
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-fade), color var(--dur-fast) var(--ease-fade);
  }

  .product__option-value:hover {
    border-color: var(--color-muted);
  }

  .product__option-input:checked + .product__option-value {
    border-color: var(--color-ink);
  }

  .product__option-input:focus-visible + .product__option-value {
    outline: 1px solid var(--color-ink);
    outline-offset: 4px;
  }

  .product__option-value.is-unavailable {
    color: var(--color-muted);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .product__details {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-hairline);
  }

  .product__detail {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-hairline);
  }

  .product__detail dt {
    font-size: var(--text-size-small);
    color: var(--color-muted);
  }

  .product__detail dd {
    margin: 0;
    text-align: right;
  }

  .product__actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .product__actions .button {
    padding: 22px 32px;
  }

  .product__actions .button--secondary {
    padding: 21px 32px;
  }

  .product__reassurance {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0;
    list-style: none;
    font-size: var(--text-size-small);
    color: var(--color-ink-soft);
  }

  .product__reassurance li,
  .product__shipping {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .product__reassurance .icon,
  .product__shipping .icon {
    margin-top: 2px;
    color: var(--color-muted);
  }

  @media (min-width: 990px) {
    .product__info.is-sticky {
      position: sticky;
      top: calc(var(--header-height) + 24px);
    }
  }

  .product__shipping {
    font-size: var(--text-size-small);
    color: var(--color-ink-soft);
  }

  .product__sold-message {
    color: var(--color-ink-soft);
  }

  .product__sold-message a {
    white-space: nowrap;
  }

  .product__about {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 8px;
  }

  .product__about-heading {
    font-size: 19px;
    font-weight: var(--font-weight-regular);
    line-height: 1.4;
  }

  /* Keep the whole painting on the first screen: the mount never grows taller than the viewport allows */
  @media (min-width: 990px) {
    .product {
      justify-content: space-between;
    }

    .product__gallery {
      max-width: max(520px, calc(100svh - var(--header-height) - 88px));
    }
  }

  @media (max-width: 989px) {
    .product__info {
      max-width: none;
    }
  }

  @media (max-width: 749px) {
    .product-crumb {
      padding-bottom: 28px;
    }

    .product__thumbs {
      gap: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "collection",
      "id": "works_collection",
      "label": "t:labels.works_collection",
      "info": "t:info.breadcrumb_collection"
    },
    {
      "type": "collection",
      "id": "sold_collection",
      "label": "t:labels.sold_collection",
      "info": "t:info.breadcrumb_sold_collection"
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "t:labels.shipping_note",
      "default": "Delivered by insured courier within South Africa. International shipping is quoted on request."
    },
    {
      "type": "textarea",
      "id": "reassurance",
      "label": "t:labels.reassurance",
      "info": "t:info.reassurance"
    },
    {
      "type": "checkbox",
      "id": "show_scale",
      "label": "t:labels.show_scale",
      "info": "t:info.show_scale",
      "default": true
    },
    {
      "type": "header",
      "content": "t:headers.sold_paintings"
    },
    {
      "type": "text",
      "id": "sold_message",
      "label": "t:labels.sold_message",
      "default": "This painting has found a home."
    },
    {
      "type": "text",
      "id": "sold_link_text",
      "label": "t:labels.sold_link_text",
      "default": "Enquire about commissions or similar works."
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
