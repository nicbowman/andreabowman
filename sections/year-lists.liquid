<section class="page-width year-lists" aria-labelledby="Heading-{{ section.id }}">
  <h2 id="Heading-{{ section.id }}" class="year-lists__heading">{{ section.settings.heading | escape }}</h2>

  <div class="year-lists__groups">
    {%- for block in section.blocks -%}
      {%- liquid
        assign starts_group = false
        if block.type == 'group'
          assign starts_group = true
        elsif forloop.first
          assign starts_group = true
        endif
        unless starts_group
          continue
        endunless

        if block.type == 'group'
          assign entries_from = forloop.index
          assign next_block = section.blocks[forloop.index]
          if next_block == blank or next_block.type == 'group'
            continue
          endif
        else
          assign entries_from = forloop.index0
        endif
      -%}
      <div class="year-lists__group">
        {%- if block.type == 'group' -%}
          <h3 class="year-lists__group-heading" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h3>
        {%- endif -%}
        <ul class="year-lists__list" role="list">
          {%- for entry in section.blocks offset: entries_from -%}
            {%- if entry.type == 'group' -%}
              {%- break -%}
            {%- endif -%}
            <li class="year-lists__row" {{ entry.shopify_attributes }}>
              <span class="year-lists__year">{{ entry.settings.year | escape }}</span>
              <span>{{ entry.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .year-lists {
    display: flex;
    flex-wrap: wrap;
    gap: var(--block-gap);
    padding-bottom: var(--section-space);
  }

  .year-lists__heading {
    flex: 1 1 360px;
  }

  .year-lists__groups {
    flex: 2 1 560px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .year-lists__group-heading {
    margin-bottom: 12px;
    font-size: 17px;
    font-weight: var(--font-weight-regular);
    line-height: 1.5;
  }

  .year-lists__list {
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-hairline);
  }

  .year-lists__row {
    display: flex;
    gap: 40px;
    padding: 14px 0;
    border-top: 1px solid var(--color-hairline);
  }

  .year-lists__year {
    flex: 0 0 64px;
    color: var(--color-muted);
  }

  @media (max-width: 749px) {
    .year-lists {
      gap: 32px;
    }

    .year-lists__heading,
    .year-lists__groups {
      flex-basis: 100%;
    }

    .year-lists__row {
      gap: 20px;
    }

    .year-lists__year {
      flex-basis: 52px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.year_lists",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.year_lists"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Background"
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "t:general.list_heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "[List heading]"
        }
      ]
    },
    {
      "type": "entry",
      "name": "t:general.list_entry",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "t:labels.year",
          "default": "[Year]"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text",
          "default": "[Entry]"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.year_lists",
      "blocks": [
        { "type": "group" },
        { "type": "entry" },
        { "type": "entry" }
      ]
    }
  ]
}
{% endschema %}
