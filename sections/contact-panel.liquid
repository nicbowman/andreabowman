{%- liquid
  # Links to the chosen contact page open this panel instead, on every page except the contact page itself.
  assign contact_path = section.settings.contact_page.url | default: '/pages/contact'
  assign form_id = 'ContactPanelForm'
  assign panel_open = false
  assign email = settings.contact_email | strip
  assign whatsapp = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
-%}

{%- capture panel_body -%}
  {%- comment -%} Filled in when a product card's Enquire now opens the panel; empty for general contact {%- endcomment -%}
  <div class="enquiry-summary" data-panel-item hidden>
    {%- comment -%} The image is set by script from the card that opened the panel {%- endcomment -%}
    {% render 'painting-mount', alt: '', class: 'enquiry-summary__image' %}
    <div class="enquiry-summary__text">
      <span class="enquiry-summary__title" data-panel-item-title></span>
      <span class="enquiry-summary__meta" data-panel-item-meta></span>
    </div>
  </div>

  {%- if section.settings.text != blank -%}
    <div class="rte contact-panel__text">{{ section.settings.text }}</div>
  {%- endif -%}

  {%- form 'contact', id: form_id, class: 'contact-panel__form' -%}
    {%- if form.posted_successfully? or form.errors -%}
      {%- assign panel_open = true -%}
    {%- endif -%}
    {%- if form.posted_successfully? -%}
      <div class="form-sent" data-form-sent>
      <p class="form-message form-message--success" role="status">
        {%- render 'icon', name: 'check' -%}
        <span>{{ section.settings.success_message | escape }}</span>
      </p>
        <button type="button" class="form-sent__again" data-form-again>{{ 'contact.send_another' | t }}</button>
      </div>
    {%- endif -%}
    <div class="form-fields" data-form-fields{% if form.posted_successfully? %} hidden{% endif %}>
      {%- if form.errors -%}
        <div class="form-message" role="alert" id="{{ form_id }}-errors">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <input type="hidden" name="contact[Enquiry]" value="{{ 'contact.panel_enquiry' | t | escape }}" data-panel-enquiry>
      <input type="hidden" name="contact[Enquiring about]" value="" disabled data-panel-item-input>
      <input type="hidden" name="contact[Page]" value="{{ request.origin }}{{ request.path }}">

      <label class="field" for="{{ form_id }}-name">
        {{- 'contact.name' | t -}}
        <input class="field__input" id="{{ form_id }}-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
      </label>

      <label class="field" for="{{ form_id }}-email">
        {{- 'contact.email' | t -}}
        <input
          class="field__input"
          id="{{ form_id }}-email"
          type="email"
          name="contact[email]"
          autocomplete="email"
          value="{{ form.email }}"
          required
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="{{ form_id }}-errors"
          {% endif %}
        >
      </label>

      <label class="field" for="{{ form_id }}-phone">
        {{- 'contact.phone' | t -}}
        <input class="field__input" id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
      </label>

      <label class="field" for="{{ form_id }}-message">
        {{- 'contact.message' | t -}}
        <textarea
          class="field__input"
          id="{{ form_id }}-message"
          name="contact[body]"
          rows="4"
          {% if section.settings.message_placeholder != blank %}
            placeholder="{{ section.settings.message_placeholder | escape }}"
          {% endif %}
        >
          {%- unless form.posted_successfully? -%}{{- form.body -}}{%- endunless -%}
        </textarea>
      </label>

      <button class="button" type="submit">{{ section.settings.submit_label | escape }}</button>
      {% render 'consent-note' %}
    </div>
  {%- endform -%}

  {%- if section.settings.show_contact_details -%}
    {%- if email != blank or whatsapp != blank -%}
      <ul class="contact-panel__details" role="list">
        {%- if email != blank -%}
          <li>
            {%- render 'icon', name: 'mail' -%}
            <a href="mailto:{{ email }}">{{ email | escape }}</a>
          </li>
        {%- endif -%}
        {%- if whatsapp != blank -%}
          <li>
            {%- render 'icon', name: 'chat' -%}
            <a href="https://wa.me/{{ whatsapp }}" target="_blank" rel="noopener">
              {{- settings.whatsapp_number | escape -}}
              <span class="visually-hidden"> {{ 'accessibility.new_window' | t }}</span>
            </a>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{% render 'side-panel',
  id: 'contact-panel',
  title: section.settings.heading,
  content: panel_body,
  form_id: form_id,
  open: panel_open,
  contact_path: contact_path
%}

{% javascript %}
  (function () {
    var panel = document.getElementById('contact-panel');
    if (!panel) return;
    var title = panel.querySelector('.side-panel__title');
    var defaultTitle = title ? title.textContent : '';
    var enquiry = panel.querySelector('[data-panel-enquiry]');
    var defaultEnquiry = enquiry ? enquiry.value : '';
    var item = panel.querySelector('[data-panel-item]');
    var input = panel.querySelector('[data-panel-item-input]');

    function reset() {
      if (title) title.textContent = defaultTitle;
      if (enquiry) enquiry.value = defaultEnquiry;
      if (item) item.hidden = true;
      if (input) {
        input.value = '';
        input.disabled = true;
      }
    }

    /* A product card's Enquire now names the painting or piece in the panel and in the email;
       any other way in (the menu's Contact link) opens the general form */
    document.addEventListener('click', function (event) {
      var trigger = event.target.closest('[data-card-enquire]');
      if (!trigger) {
        var link = event.target.closest('a[href]');
        if (link && link.pathname === panel.getAttribute('data-contact-path')) reset();
        return;
      }
      if (!item || !input) return;
      if (title) title.textContent = trigger.getAttribute('data-enquire-heading') || defaultTitle;
      if (enquiry) enquiry.value = trigger.getAttribute('data-enquire-heading') || defaultEnquiry;
      item.querySelector('[data-panel-item-title]').textContent = trigger.getAttribute('data-enquire-title');
      item.querySelector('[data-panel-item-meta]').textContent = trigger.getAttribute('data-enquire-meta') || '';
      var mount = item.querySelector('.enquiry-summary__image');
      var image = mount.querySelector('img');
      if (!image) {
        image = document.createElement('img');
        image.className = 'mount__image';
        image.width = 96;
        image.height = 96;
        mount.appendChild(image);
      }
      image.src = trigger.getAttribute('data-enquire-image') || '';
      image.alt = trigger.getAttribute('data-enquire-title') || '';
      item.hidden = false;
      input.value = trigger.getAttribute('data-enquire-item') || '';
      input.disabled = false;
    }, true);

    /* Back to a general contact form once closed */
    panel.addEventListener('close', reset);
  })();
{% endjavascript %}

{% stylesheet %}
  .contact-panel__text p {
    color: var(--color-ink-soft);
    font-size: var(--text-size-small);
  }

  .contact-panel__details {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 0 0;
    border-top: 1px solid var(--color-hairline);
    list-style: none;
    font-size: var(--text-size-small);
  }

  .contact-panel__details li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .contact-panel__details .icon {
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact_panel",
  "settings": [
    {
      "type": "page",
      "id": "contact_page",
      "label": "t:labels.contact_page",
      "info": "t:info.contact_panel_page"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Get in touch"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Ask about a painting, a commission or a project. I reply to every message personally.</p>"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "t:labels.message_placeholder",
      "default": "How can I help?"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "t:labels.submit_label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "t:labels.success_message",
      "default": "Thank you. Your message has been sent, and I will reply to you by email."
    },
    {
      "type": "checkbox",
      "id": "show_contact_details",
      "label": "t:labels.show_contact_details",
      "default": true
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
