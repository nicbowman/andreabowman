{%- liquid
  # Links to the chosen contact page open this panel instead, on every page except the contact page itself.
  assign contact_path = section.settings.contact_page.url | default: '/pages/contact'
  assign form_id = 'ContactPanelForm'
  assign panel_open = false
  assign email = settings.contact_email | strip
  assign whatsapp = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
-%}

{%- capture panel_body -%}
  {%- if section.settings.text != blank -%}
    <div class="rte contact-panel__text">{{ section.settings.text }}</div>
  {%- endif -%}

  {%- form 'contact', id: form_id, class: 'contact-panel__form' -%}
    {%- if form.posted_successfully? or form.errors -%}
      {%- assign panel_open = true -%}
    {%- endif -%}
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success" role="status">
        {%- render 'icon', name: 'check' -%}
        <span>{{ section.settings.success_message | escape }}</span>
      </p>
    {%- else -%}
      {%- if form.errors -%}
        <div class="form-message" role="alert" id="{{ form_id }}-errors">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <input type="hidden" name="contact[Enquiry]" value="{{ 'contact.panel_enquiry' | t | escape }}">
      <input type="hidden" name="contact[Page]" value="{{ request.origin }}{{ request.path }}">

      <label class="field" for="{{ form_id }}-name">
        {{- 'contact.name' | t -}}
        <input class="field__input" id="{{ form_id }}-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
      </label>

      <label class="field" for="{{ form_id }}-email">
        {{- 'contact.email' | t -}}
        <input
          class="field__input"
          id="{{ form_id }}-email"
          type="email"
          name="contact[email]"
          autocomplete="email"
          value="{{ form.email }}"
          required
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="{{ form_id }}-errors"
          {% endif %}
        >
      </label>

      <label class="field" for="{{ form_id }}-phone">
        {{- 'contact.phone' | t -}}
        <input class="field__input" id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
      </label>

      <label class="field" for="{{ form_id }}-message">
        {{- 'contact.message' | t -}}
        <textarea
          class="field__input"
          id="{{ form_id }}-message"
          name="contact[body]"
          rows="4"
          {% if section.settings.message_placeholder != blank %}
            placeholder="{{ section.settings.message_placeholder | escape }}"
          {% endif %}
        >
          {{- form.body -}}
        </textarea>
      </label>

      <button class="button" type="submit">{{ section.settings.submit_label | escape }}</button>
      {% render 'consent-note' %}
    {%- endif -%}
  {%- endform -%}

  {%- if section.settings.show_contact_details -%}
    {%- if email != blank or whatsapp != blank -%}
      <ul class="contact-panel__details" role="list">
        {%- if email != blank -%}
          <li>
            {%- render 'icon', name: 'mail' -%}
            <a href="mailto:{{ email }}">{{ email | escape }}</a>
          </li>
        {%- endif -%}
        {%- if whatsapp != blank -%}
          <li>
            {%- render 'icon', name: 'chat' -%}
            <a href="https://wa.me/{{ whatsapp }}" target="_blank" rel="noopener">
              {{- settings.whatsapp_number | escape -}}
              <span class="visually-hidden"> {{ 'accessibility.new_window' | t }}</span>
            </a>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{% render 'side-panel',
  id: 'contact-panel',
  title: section.settings.heading,
  content: panel_body,
  form_id: form_id,
  open: panel_open,
  contact_path: contact_path
%}

{% stylesheet %}
  .contact-panel__text p {
    color: var(--color-ink-soft);
    font-size: var(--text-size-small);
  }

  .contact-panel__details {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 0 0;
    border-top: 1px solid var(--color-hairline);
    list-style: none;
    font-size: var(--text-size-small);
  }

  .contact-panel__details li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .contact-panel__details .icon {
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.contact_panel",
  "settings": [
    {
      "type": "page",
      "id": "contact_page",
      "label": "t:labels.contact_page",
      "info": "t:info.contact_panel_page"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Get in touch"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Ask about a painting, a commission or a project. I reply to every message personally.</p>"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "t:labels.message_placeholder",
      "default": "How can I help?"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "t:labels.submit_label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "t:labels.success_message",
      "default": "Thank you. Your message has been sent, and I will reply to you by email."
    },
    {
      "type": "checkbox",
      "id": "show_contact_details",
      "label": "t:labels.show_contact_details",
      "default": true
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
