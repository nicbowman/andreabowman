{%- liquid
  assign image = section.settings.image
  assign image_alt = image.alt | default: section.settings.heading | escape
-%}

<section class="image-text image-text--{{ section.settings.background }}">
  <div class="page-width image-text__inner{% if section.settings.image_position == 'right' %} image-text__inner--reverse{% endif %}">
    <div class="image-text__media image-text__media--{{ section.settings.image_ratio }}">
      {%- if image -%}
        {{
          image
          | image_url: width: 2000
          | image_tag:
            widths: '500, 750, 1000, 1300, 1600, 2000',
            sizes: '(min-width: 1320px) 680px, (min-width: 990px) 55vw, 100vw',
            loading: 'lazy',
            alt: image_alt
        }}
      {%- elsif request.design_mode -%}
        <span class="visually-hidden">{{ 'general.image_placeholder' | t }}</span>
      {%- endif -%}
    </div>

    <div class="image-text__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="image-text__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
        <a class="button image-text__button" href="{{ section.settings.button_url }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .image-text--oatmeal {
    background-color: var(--color-oatmeal);
  }

  .image-text__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--block-gap);
    padding-block: var(--section-space-small);
  }

  .image-text__inner--reverse {
    flex-direction: row-reverse;
  }

  .image-text__media {
    position: relative;
    flex: 1 1 520px;
    overflow: hidden;
    background-color: var(--color-mount);
  }

  .image-text__media--landscape {
    aspect-ratio: 4 / 3;
  }

  .image-text__media--portrait {
    aspect-ratio: 4 / 5;
  }

  .image-text__media--square {
    aspect-ratio: 1 / 1;
  }

  .image-text__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .image-text__content {
    flex: 1 1 380px;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .image-text__heading {
    line-height: 1.25;
  }

  .image-text__button {
    align-self: flex-start;
  }

  @media (max-width: 749px) {
    .image-text__media,
    .image-text__content {
      flex-basis: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image_with_text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.lifestyle_image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "landscape", "label": "t:options.ratio.landscape" },
        { "value": "portrait", "label": "t:options.ratio.portrait" },
        { "value": "square", "label": "t:options.ratio.square" }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>[Text]</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:labels.button_url"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "ivory", "label": "t:options.background.ivory" },
        { "value": "oatmeal", "label": "t:options.background.oatmeal" }
      ],
      "default": "oatmeal"
    }
  ],
  "presets": [
    {
      "name": "t:general.image_with_text"
    }
  ]
}
{% endschema %}
