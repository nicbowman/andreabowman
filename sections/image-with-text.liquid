{%- liquid
  assign image = section.settings.image
  assign image_alt = image.alt | default: section.settings.heading | escape
-%}

{%- liquid
  assign heading_tag = 'h2'
  if section.settings.page_heading
    assign heading_tag = 'h1'
  endif
  assign loading = 'lazy'
  if section.settings.page_heading
    assign loading = 'eager'
  endif
-%}

<section class="image-text image-text--{{ section.settings.background }}{% if section.settings.page_heading %} image-text--page-top{% endif %}">
  <div class="page-width image-text__inner{% if section.settings.image_position == 'right' %} image-text__inner--reverse{% endif %}">
    <div class="image-text__media image-text__media--{{ section.settings.image_ratio }}">
      {%- if image -%}
        {{
          image
          | image_url: width: 2000
          | image_tag:
            widths: '500, 750, 1000, 1300, 1600, 2000',
            sizes: '(min-width: 1320px) 680px, (min-width: 990px) 55vw, 100vw',
            loading: loading,
            alt: image_alt
        }}
      {%- elsif request.design_mode -%}
        <span class="visually-hidden">{{ 'general.image_placeholder' | t }}</span>
      {%- endif -%}
    </div>

    <div class="image-text__content">
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="image-text__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- liquid
        assign has_button = false
        if section.settings.button_label != blank and section.settings.button_url != blank
          assign has_button = true
        endif
        assign has_link = false
        if section.settings.link_label != blank and section.settings.link_url != blank
          assign has_link = true
        endif
      -%}
      {%- if has_button or has_link -%}
        <div class="image-text__actions">
          {%- if has_button -%}
            <a class="button image-text__button" href="{{ section.settings.button_url }}">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
          {%- if has_link -%}
            <a class="link link--icon" href="{{ section.settings.link_url }}">
              {{- section.settings.link_label | escape -}}
              {% render 'icon', name: 'arrow-right', class: 'icon--small' %}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .image-text--oatmeal {
    background-color: var(--color-oatmeal);
  }

  .image-text__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--block-gap);
    padding-block: var(--section-space-small);
  }

  .image-text__inner--reverse {
    flex-direction: row-reverse;
  }

  .image-text__media {
    position: relative;
    flex: 1 1 520px;
    overflow: hidden;
    background-color: var(--color-mount);
  }

  .image-text__media--landscape {
    aspect-ratio: 4 / 3;
  }

  .image-text__media--portrait {
    aspect-ratio: 4 / 5;
  }

  .image-text__media--square {
    aspect-ratio: 1 / 1;
  }

  .image-text__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .image-text__content {
    flex: 1 1 380px;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .image-text__heading {
    line-height: 1.25;
  }

  .image-text__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 36px;
    padding-top: 8px;
  }

  /* Opening a page: starts just below the header, and the image never grows taller than the screen allows */
  .image-text--page-top .image-text__inner {
    padding-top: var(--page-top);
  }

  .image-text--page-top .image-text__media {
    max-width: calc((100svh - var(--header-height) - var(--page-top) - 40px) * var(--media-ratio, 1));
  }

  .image-text--page-top .image-text__media--landscape {
    --media-ratio: 1.333;
  }

  .image-text--page-top .image-text__media--portrait {
    --media-ratio: 0.8;
  }

  @media (max-width: 749px) {
    .image-text__media,
    .image-text__content {
      flex-basis: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image_with_text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.lifestyle_image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "landscape", "label": "t:options.ratio.landscape" },
        { "value": "portrait", "label": "t:options.ratio.portrait" },
        { "value": "square", "label": "t:options.ratio.square" }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Heading"
    },
    {
      "type": "checkbox",
      "id": "page_heading",
      "label": "t:labels.page_heading",
      "info": "t:info.page_heading",
      "default": false
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>[Text]</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:labels.button_url"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:labels.link_url"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "ivory", "label": "t:options.background.ivory" },
        { "value": "oatmeal", "label": "t:options.background.oatmeal" }
      ],
      "default": "oatmeal"
    }
  ],
  "presets": [
    {
      "name": "t:general.image_with_text"
    }
  ]
}
{% endschema %}
