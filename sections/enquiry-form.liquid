{%- liquid
  assign form_id = 'EnquiryForm-' | append: section.id
  assign anchor = section.settings.anchor | handleize | default: section.id
  assign as_panel = false
  if section.settings.display == 'panel'
    assign as_panel = true
  endif
  assign form_open = false
-%}

{%- comment -%}
  The download link and contact details are captured once and placed beside the form on the page,
  or under it in the side panel.
{%- endcomment -%}
{%- capture enquiry_extras -%}
      {%- if section.settings.download_label != blank and section.settings.download_url != blank -%}
        <a class="button button--secondary enquiry__download" href="{{ section.settings.download_url }}" target="_blank" rel="noopener">
          {{- section.settings.download_label | escape -}}
          <span class="visually-hidden"> {{ 'accessibility.new_window' | t }}</span>
        </a>
      {%- endif -%}

      {%- if section.settings.show_contact_details -%}
        {%- liquid
          assign email = settings.contact_email | strip
          assign whatsapp = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
        -%}
        <ul class="enquiry__details" role="list">
          {%- if email != blank -%}
            <li class="enquiry__detail">
              {%- render 'icon', name: 'mail' -%}
              <span class="enquiry__detail-text">
                <span class="enquiry__details-label">{{ 'contact.by_email' | t }}</span>
                <a href="mailto:{{ email }}">{{ email | escape }}</a>
              </span>
            </li>
          {%- endif -%}
          {%- if whatsapp != blank -%}
            <li class="enquiry__detail">
              {%- render 'icon', name: 'chat' -%}
              <span class="enquiry__detail-text">
                <span class="enquiry__details-label">{{ 'contact.by_whatsapp' | t }}</span>
                <a href="https://wa.me/{{ whatsapp }}" target="_blank" rel="noopener">{{ settings.whatsapp_number | escape }}</a>
              </span>
            </li>
          {%- endif -%}
          {%- if settings.instagram_url != blank -%}
            <li class="enquiry__detail">
              {%- render 'icon', name: 'instagram' -%}
              <span class="enquiry__detail-text">
                <span class="enquiry__details-label">{{ 'contact.on_instagram' | t }}</span>
                <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">{{ 'footer.instagram' | t }}</a>
              </span>
            </li>
          {%- endif -%}
          {%- if section.settings.details_note != blank -%}
            <li class="enquiry__details-note">{{ section.settings.details_note | escape }}</li>
          {%- endif -%}
        </ul>
      {%- endif -%}
{%- endcapture -%}

{%- capture enquiry_form -%}
    {%- form 'contact', id: form_id, class: 'enquiry__form' -%}
      {%- if form.posted_successfully? or form.errors -%}
        {%- assign form_open = true -%}
      {%- endif -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">
          {%- render 'icon', name: 'check' -%}
          <span>{{ section.settings.success_message | escape }}</span>
        </p>
      {%- else -%}
        {%- if form.errors -%}
          <div class="form-message" role="alert" id="{{ form_id }}-errors">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        {%- if section.settings.enquiry_type != blank -%}
          <input type="hidden" name="contact[Enquiry]" value="{{ section.settings.enquiry_type | escape }}">
        {%- endif -%}

        <div class="enquiry__row">
          <label class="field" for="{{ form_id }}-name">
            {{- 'contact.name' | t -}}
            <input
              class="field__input"
              id="{{ form_id }}-name"
              type="text"
              name="contact[name]"
              autocomplete="name"
              value="{{ form.name }}"
              required
            >
          </label>

          <label class="field" for="{{ form_id }}-email">
            {{- 'contact.email' | t -}}
            <input
              class="field__input"
              id="{{ form_id }}-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              value="{{ form.email }}"
              required
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="{{ form_id }}-errors"
              {% endif %}
            >
          </label>
        </div>

        <label class="field" for="{{ form_id }}-phone">
          {{- 'contact.phone' | t -}}
          <input
            class="field__input"
            id="{{ form_id }}-phone"
            type="tel"
            name="contact[phone]"
            autocomplete="tel"
            value="{{ form.phone }}"
          >
        </label>

        {%- if section.settings.show_project_fields -%}
          <label class="field" for="{{ form_id }}-studio">
            {{- 'contact.studio' | t -}}
            <input
              class="field__input"
              id="{{ form_id }}-studio"
              type="text"
              name="contact[Studio]"
              autocomplete="organization"
            >
          </label>

          <label class="field" for="{{ form_id }}-project">
            {{- 'contact.project' | t -}}
            <input
              class="field__input"
              id="{{ form_id }}-project"
              type="text"
              name="contact[Project]"
              placeholder="{{ 'contact.project_placeholder' | t }}"
            >
          </label>

          <label class="field" for="{{ form_id }}-timeline">
            {{- 'contact.timeline' | t -}}
            <select class="field__input" id="{{ form_id }}-timeline" name="contact[Timeline]">
              <option value="">{{ 'contact.timeline_choose' | t }}</option>
              <option>{{ 'contact.timeline_month' | t }}</option>
              <option>{{ 'contact.timeline_quarter' | t }}</option>
              <option>{{ 'contact.timeline_later' | t }}</option>
              <option>{{ 'contact.timeline_unsure' | t }}</option>
            </select>
          </label>
        {%- endif -%}

        <label class="field" for="{{ form_id }}-message">
          {{- 'contact.message' | t -}}
          <textarea
            class="field__input"
            id="{{ form_id }}-message"
            name="contact[body]"
            rows="4"
            {% if section.settings.message_placeholder != blank %}
              placeholder="{{ section.settings.message_placeholder | escape }}"
            {% endif %}
          >
            {{- form.body -}}
          </textarea>
        </label>

        <button class="button enquiry__submit" type="submit">{{ section.settings.submit_label | escape }}</button>
        {% render 'consent-note' %}
      {%- endif -%}
    {%- endform -%}
{%- endcapture -%}

{%- if as_panel -%}
  {%- comment -%} A slim closing band on the page; the form itself opens in a side panel at #anchor {%- endcomment -%}
  <section class="enquiry enquiry--{{ section.settings.background }}" aria-labelledby="Heading-{{ section.id }}">
    <div class="page-width enquiry__prompt">
      <div class="enquiry__prompt-text">
        <h2 id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
      <a class="button" href="#{{ anchor }}" data-side-panel-open="{{ anchor }}">
        {{- section.settings.open_label | default: section.settings.submit_label | escape -}}
      </a>
    </div>
  </section>

  {%- capture panel_body -%}
    {{ enquiry_form }}
    {%- if enquiry_extras != blank -%}
      <div class="enquiry__panel-extras">{{ enquiry_extras }}</div>
    {%- endif -%}
  {%- endcapture -%}
  {% render 'side-panel', id: anchor, title: section.settings.heading, content: panel_body, form_id: form_id, open: form_open %}
{%- else -%}
  <section id="{{ anchor }}" class="enquiry enquiry--{{ section.settings.background }}" aria-labelledby="Heading-{{ section.id }}">
    <div class="page-width enquiry__inner">
      <div class="enquiry__intro">
        <h2 id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {{ enquiry_extras }}
      </div>
      {{ enquiry_form }}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .enquiry--oatmeal {
    background-color: var(--color-oatmeal);
  }

  .enquiry__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--block-gap);
    padding-block: var(--section-space-small);
  }

  /* On ivory straight after a page intro, the form continues the intro rather than starting a new band */
  .shopify-section:has(> .page-intro) + .shopify-section > .enquiry--ivory .enquiry__inner {
    padding-top: 8px;
  }

  /* Panel mode: one line of text and a button on the page */
  .enquiry__prompt {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px 48px;
    padding-block: var(--section-space-small);
  }

  .enquiry__prompt-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 640px;
  }

  .enquiry__prompt-text p {
    color: var(--color-ink-soft);
  }

  .enquiry__panel-extras {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline);
  }

  .enquiry__intro {
    flex: 1 1 380px;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .enquiry__intro h2 {
    line-height: 1.25;
  }

  .enquiry__form {
    flex: 1 1 520px;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  .enquiry__row {
    display: flex;
    flex-wrap: wrap;
    gap: 34px 32px;
  }

  .enquiry__row .field {
    flex: 1 1 240px;
  }

  .enquiry__download {
    align-self: flex-start;
  }

  .enquiry__details {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px 0 0;
    border-top: 1px solid var(--color-hairline);
    list-style: none;
  }

  .enquiry__detail {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .enquiry__detail .icon {
    margin-top: 4px;
    color: var(--color-muted);
  }

  .enquiry__detail-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .enquiry__details-label {
    font-size: var(--text-size-label);
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .enquiry__details-note {
    color: var(--color-ink-soft);
  }

  .enquiry__submit {
    align-self: flex-start;
    padding: 22px 44px;
  }

  .enquiry .field__input::placeholder {
    color: var(--color-muted);
    opacity: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.enquiry_form",
  "settings": [
    {
      "type": "select",
      "id": "display",
      "label": "t:labels.form_display",
      "info": "t:info.form_display",
      "options": [
        { "value": "page", "label": "t:options.form_display.page" },
        { "value": "panel", "label": "t:options.form_display.panel" }
      ],
      "default": "page"
    },
    {
      "type": "text",
      "id": "open_label",
      "label": "t:labels.open_label",
      "info": "t:info.open_label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Get in touch"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "text",
      "id": "download_label",
      "label": "t:labels.download_label"
    },
    {
      "type": "url",
      "id": "download_url",
      "label": "t:labels.download_url",
      "info": "t:info.download_url"
    },
    {
      "type": "checkbox",
      "id": "show_contact_details",
      "label": "t:labels.show_contact_details",
      "info": "t:info.show_contact_details",
      "default": false
    },
    {
      "type": "text",
      "id": "details_note",
      "label": "t:labels.details_note"
    },
    {
      "type": "checkbox",
      "id": "show_project_fields",
      "label": "t:labels.show_project_fields",
      "info": "t:info.show_project_fields",
      "default": false
    },
    {
      "type": "text",
      "id": "enquiry_type",
      "label": "t:labels.enquiry_type",
      "info": "t:info.enquiry_type"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "t:labels.message_placeholder"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "t:labels.submit_label",
      "default": "Send"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "t:labels.success_message",
      "default": "Thank you. Your message has been sent, and Andrea will reply to you by email."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:labels.anchor",
      "info": "t:info.anchor",
      "default": "enquire"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "ivory", "label": "t:options.background.ivory" },
        { "value": "oatmeal", "label": "t:options.background.oatmeal" }
      ],
      "default": "oatmeal"
    }
  ],
  "presets": [
    {
      "name": "t:general.enquiry_form"
    }
  ]
}
{% endschema %}
